---
// Self-host it: one sentence, the three commands in one block with one Copy button, what you
// need in one quiet line, and the way to the full guide. The commands come from
// content/self-host.ts, which a unit test keeps in step with the README; every detail lives on
// the guide's page.
import CopyCommand from "../components/CopyCommand.astro"
import { SELF_HOST_COMMANDS } from "../content/self-host"
import type { Messages } from "../i18n"
import { ANALYTICS_EVENTS } from "../lib/analytics"
import { GUIDE_URL } from "../links"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<section id="self-host" class="section" aria-labelledby="self-host-title">
  <div class="container self-host">
    <div>
      <h2 id="self-host-title">{m.selfHost.title}</h2>
      <p class="lead">{m.selfHost.line}</p>
    </div>
    <div class="self-host-start">
      <CopyCommand m={m} id="self-host-commands" command={SELF_HOST_COMMANDS.join("\n")} />
      <p class="needs">{m.selfHost.requirements}</p>
      <a class="btn btn-primary" href={GUIDE_URL} data-umami-event={ANALYTICS_EVENTS.guide} data-umami-event-place="self-host">{m.selfHost.guide}</a>
    </div>
  </div>
</section>

<style>
  .self-host { display: grid; gap: 2rem; align-items: start; }
  /* Grid and flex children default to their content's width; a long command must not widen the
     page, so every box on the way down may shrink, and the commands scroll inside their own box. */
  .self-host > div { min-width: 0; }
  .self-host .lead { margin: 0; }
  .self-host-start { display: grid; justify-items: start; gap: 1rem; }
  .self-host-start :global(.command) { justify-self: stretch; }
  @media (max-width: 719px) {
    .self-host > div:first-child { text-align: center; }
    .self-host .lead { margin-inline: auto; }
    .self-host-start { justify-items: center; }
  }
  .needs { margin: 0; color: var(--muted-foreground); font-size: 0.9375rem; }
  /* Side by side only where there is room: the commands' column takes the width of the longest
     command, so it never has to scroll, and the title takes the rest. */
  @media (min-width: 1100px) { .self-host { grid-template-columns: minmax(0, 1fr) auto; column-gap: 3rem; } }
</style>
