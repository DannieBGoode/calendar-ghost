---
// Hero C, the headline is the demo: "Work sees" and then a real event. The ghost draws Busy over
// Sam's Dentist like a blind, lifts it to show what is under it, and draws it again. Assistive
// technology reads one plain sentence instead. Under it, the pitch and two days of the Wide Reveal
// as proof. Without JavaScript or with reduced motion, the headline rests on Busy.
import { Ghost } from "../../islands/Ghost"
import { LoopStage } from "../../islands/LoopStage"
import { WideReveal } from "../../islands/WideReveal"
import type { Messages } from "../../i18n"
import { DENTIST_TIME, clock } from "../journey/crossing"
import HeroPitch from "./HeroPitch.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
const copy = m.variants.homeHeroes
const dentist = m.demo.events.dentist
const time = `${clock(DENTIST_TIME.start)}–${clock(DENTIST_TIME.end)}`
---

<section class="hh hh-c" aria-labelledby="hero-title">
  <div class="hh-c-wrap">
    <LoopStage client:load motion={m.motion} compact className="hh-c-stage">
      <h1 id="hero-title" class="hh-c-title">
        <span class="sr-only">{copy.c.title}</span>
        <span class="hh-c-says" aria-hidden="true">
          <span class="hh-c-lead">{copy.c.lead}</span>
          <span class="hh-c-slot">
            <span class="hh-c-chip hh-c-dentist">
              <b>{dentist.title}</b>
              <small>{dentist.detail} · {time}</small>
            </span>
            <span class="hh-c-cover">
              <span class="hh-c-chip hh-c-busy">
                <b>{m.demo.busy}</b>
                <small>{time}</small>
              </span>
            </span>
            <span class="hh-c-wiper">
              <span class="hh-c-edge"></span>
              <Ghost face="neutral" then="happy" alive="loop" className="hh-c-ghost" />
            </span>
          </span>
        </span>
      </h1>
    </LoopStage>
    <div class="hh-c-body">
      <div class="hh-c-pitch">
        <HeroPitch m={m} />
      </div>
      <div class="hh-c-proof">
        <WideReveal
          client:load
          m={m.demo}
          motion={m.motion}
          weekHeight={380}
          phoneWeekHeight={260}
          handleSize={76}
          phoneHandleSize={64}
          ghostTone="mist"
          sweep={{ rest: 50, swing: 32 }}
          labels="divider"
          handleHint={copy.handleHint}
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Clipped sideways: the blind's moving parts reach past the event at either end of a run. */
  .hh-c { overflow-x: clip; padding-block: clamp(3rem, 8vh, 5rem) 0; }
  .hh-c-wrap { width: min(72rem, 100% - 2 * var(--hh-gutter)); margin-inline: auto; }

  /* The headline and, at its right, the pause control for its loop. */
  .hh-c-wrap :global(.hh-c-stage) { display: flex; align-items: flex-start; gap: 1rem; }
  .hh-c-wrap :global(.hh-c-stage > .demo-foot) { margin: 0 0 0 auto; }
  .hh-c-title { margin: 0; font-size: clamp(3rem, 1.2rem + 5.6vw, 6.25rem); line-height: 1.05; letter-spacing: -0.035em; text-wrap: wrap; }
  .hh-c-title .hh-c-says { display: block; }
  .hh-c-lead { display: inline-block; margin-right: 0.22em; }

  /* The event: Sam's Dentist, with Busy over it. Both fill one grid cell, so they are the same
     size, as a calendar slot would be. */
  .hh-c-slot { position: relative; display: inline-grid; vertical-align: baseline; }
  .hh-c-slot > * { grid-area: 1 / 1; }
  .hh-c-chip {
    display: grid; align-content: start; height: 100%; padding: 0.08em 0.3em 0.16em;
    border: 2px solid var(--event-edge); border-radius: 0.16em; color: var(--foreground);
  }
  .hh-c-chip b { font-weight: inherit; line-height: 1; }
  .hh-c-chip small {
    margin-top: 0.3em; font: 600 clamp(0.875rem, 0.55rem + 0.55vw, 1.125rem)/1.2 var(--font-sans);
    letter-spacing: 0; white-space: nowrap;
  }
  .hh-c-dentist { --event-edge: var(--event-personal-edge); background: var(--event-personal); }
  .hh-c-busy {
    --event-edge: var(--primary);
    border-style: dashed;
    background:
      repeating-linear-gradient(45deg, color-mix(in oklch, var(--primary) 12%, transparent) 0 0.09em, transparent 0.09em 0.18em),
      linear-gradient(var(--event-busy), var(--event-busy)),
      var(--background);
  }
  /* A blind made of two transforms: the cover slides in from the left while the Busy inside it
     slides the other way, so Busy seems to stay put and only its edge moves. */
  .hh-c-cover { position: relative; overflow: hidden; border-radius: 0.16em; }
  .hh-c-wiper { position: relative; pointer-events: none; transform: translateX(100%); }
  .hh-c-edge {
    position: absolute; top: -0.06em; bottom: -0.06em; left: -1.5px; width: 3px; border-radius: 3px;
    background: var(--primary); opacity: 0;
  }
  /* The ghost sits on the slot's top edge, at the blind's edge, like a cat on a box. */
  .hh-c-wiper :global(.hh-c-ghost) {
    --ghost-size: 0.82em; --ghost-glow-r: 0.16em;
    position: absolute; left: 0; bottom: calc(100% - 0.2em); transform: translateX(-50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hh-c-wrap :global(.hh-c-stage[data-hydrated="true"]) .hh-c-cover { animation: hh-c-cover 8s infinite; }
    .hh-c-wrap :global(.hh-c-stage[data-hydrated="true"]) .hh-c-busy { animation: hh-c-busy 8s infinite; }
    .hh-c-wrap :global(.hh-c-stage[data-hydrated="true"]) .hh-c-wiper { animation: hh-c-wiper 8s infinite; }
    .hh-c-wrap :global(.hh-c-stage[data-hydrated="true"]) .hh-c-edge { animation: hh-c-edge 8s infinite; }
    .hh-c-wrap :global(.hh-c-stage[data-hydrated="true"]) .hh-c-lead { animation: hh-c-lead 8s infinite; }
    .hh-c-wrap :global(.hh-c-stage[data-hydrated="true"] .hh-c-ghost[data-sequence] .ghost-face-first) { animation: hh-c-face-first 8s infinite; }
    .hh-c-wrap :global(.hh-c-stage[data-hydrated="true"] .hh-c-ghost[data-sequence] .ghost-face-then) { animation: hh-c-face-then 8s infinite; }
  }
  .hh-c-wrap :global(.hh-c-stage[data-playing="false"]) .hh-c-says *,
  .hh-c-wrap :global(.hh-c-stage[data-playing="false"] .hh-c-says *) { animation-play-state: paused !important; }

  /* Eight seconds: Busy, then the blind lifts to show the Dentist, then comes down again and Busy
     holds the longest. Each move eases in and out. */
  @keyframes hh-c-cover {
    0%, 15% { transform: translateX(0); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    27%, 45% { transform: translateX(-100%); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    59%, 100% { transform: translateX(0); }
  }
  @keyframes hh-c-busy {
    0%, 15% { transform: translateX(0); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    27%, 45% { transform: translateX(100%); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    59%, 100% { transform: translateX(0); }
  }
  @keyframes hh-c-wiper {
    0%, 15% { transform: translateX(100%); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    27%, 45% { transform: translateX(0); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    59%, 100% { transform: translateX(100%); }
  }
  @keyframes hh-c-edge {
    0%, 13% { opacity: 0; }
    16%, 26% { opacity: 1; }
    29%, 43% { opacity: 0; }
    46%, 58% { opacity: 1; }
    61%, 100% { opacity: 0; }
  }
  /* While the blind is up, "Work sees" steps back: the sentence is only whole when it says Busy. */
  @keyframes hh-c-lead {
    0%, 17% { opacity: 1; }
    25%, 47% { opacity: 0.28; }
    57%, 100% { opacity: 1; }
  }
  @keyframes hh-c-face-first {
    0%, 14% { opacity: 0; }
    15%, 27% { opacity: 1; }
    28%, 44% { opacity: 0; }
    45%, 59% { opacity: 1; }
    60%, 100% { opacity: 0; }
  }
  @keyframes hh-c-face-then {
    0%, 14% { opacity: 1; }
    15%, 27% { opacity: 0; }
    28%, 44% { opacity: 1; }
    45%, 59% { opacity: 0; }
    60%, 100% { opacity: 1; }
  }

  /* The pitch, and two days of Sam's week as proof. */
  .hh-c-body { display: grid; gap: 2rem; margin-top: clamp(1.75rem, 4vh, 2.75rem); }
  .hh-c-proof { min-width: 0; }
  .hh-c-proof :global(.reveal) { margin: 0; }
  .hh-c-proof :global(.reveal-frame .reveal-week) { width: 250%; }
  .hh-c-proof :global(.cal-event) { padding: 3px 9px; font-size: 0.8125rem; }
  .hh-c-proof :global(.cal-event > small) { font-size: 0.8125rem; }
  /* Phones: the event wraps under "Work sees", so the lines open up to give the ghost room. */
  @media (max-width: 639px) {
    .hh-c-title { font-size: 2.75rem; line-height: 1.4; }
    .hh-c-wiper :global(.hh-c-ghost) { --ghost-size: 0.72em; bottom: calc(100% - 0.14em); }
  }
  @media (min-width: 900px) {
    .hh-c-body { grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); column-gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
    .hh-c-pitch { padding-top: 0.5rem; }
  }
</style>
