---
// Hero E, a node diagram (after agentic.littleplains.com): an event's parts in outlined pills,
// hairlines into one outlined ghost, and hairlines out to Sam's calendars. Short coloured segments
// travel the curves and tell the rule: the time reaches every calendar, the title, place, and
// description reach only Personal (its rule copies details), and the parts that never cross over
// stop short of the ghost with a small end cap. The geometry and timing come from
// node-diagram.ts; the motion is CSS (node-diagram.css). Without JavaScript or with reduced
// motion the diagram stands still with its routes and stops drawn in colour.
import "./node-diagram.css"
import { avatarUrls } from "../../avatars"
import type { Messages } from "../../i18n"
import { format } from "../../i18n/format"
import HeroPitch from "./HeroPitch.astro"
import { CYCLE_S, buildDiagram, dashFor, type Diagram } from "./node-diagram"
import { NodeDiagramControls } from "./NodeDiagramControls"

interface Props {
  m: Messages
}

const { m } = Astro.props
const [firstLine, secondLine] = m.variants.bold.hero.titleLines
const nd = m.variants.homeHeroes.nodeDiagram
const avatars = await avatarUrls()
const diagrams: Diagram[] = [buildDiagram("wide"), buildDiagram("tall")]

/** Each layout's type sizes, in diagram units. */
const TYPE = {
  wide: { pill: 16.5, name: 22, pad: 15, avatar: 22 },
  tall: { pill: 13.5, name: 17, pad: 11, avatar: 20 },
} as const
---

<section class="hh hh-e" aria-labelledby="hero-title">
  <div class="hh-e-wrap">
    <div class="hh-e-copy">
      <h1 id="hero-title"><span>{firstLine}</span> <span class="hh-accent">{secondLine}</span></h1>
      <div class="hh-e-pitch"><HeroPitch m={m} /></div>
    </div>

    <figure class="nd" data-playing="true" style={`--nd-cycle: ${CYCLE_S}s`} aria-labelledby="nd-summary">
      <figcaption id="nd-summary" class="sr-only">{nd.summary}</figcaption>
      <ul class="sr-only">
        {nd.facts.map((fact) => <li>{fact}</li>)}
      </ul>

      {
        diagrams.map((diagram) => {
          const type = TYPE[diagram.kind]
          return (
            <svg
              class={`nd-svg nd-${diagram.kind}`}
              viewBox={`0 0 ${diagram.width} ${diagram.height}`}
              aria-hidden="true"
              focusable="false"
            >
              <defs>
                {diagram.destinations.map((pill) => {
                  const top = pill.y + (pill.height - type.avatar) / 2
                  return (
                    <clipPath id={`nd-${diagram.kind}-${pill.key}`}>
                      <circle cx={pill.x + type.pad + type.avatar / 2} cy={top + type.avatar / 2} r={type.avatar / 2} />
                    </clipPath>
                  )
                })}
              </defs>

              <g class="nd-curves">
                {diagram.curves.map((curve) => (
                  <path d={curve.d} data-curve={curve.id} />
                ))}
              </g>
              <path class="nd-hub" d={diagram.stubs} />

              <g class="nd-legs">
                {diagram.legs.map((leg) => {
                  const dash = dashFor(leg)
                  return (
                    <path
                      class="nd-leg"
                      d={leg.d}
                      data-part={leg.part}
                      data-to={leg.to}
                      data-role={leg.role}
                      data-still={leg.still === null ? undefined : ""}
                      style={`--dash: ${dash.dasharray}; --from: ${dash.from}; --to: ${dash.to}; --still: ${dash.still}; --delay: ${leg.delay}s`}
                    />
                  )
                })}
              </g>
              <g class="nd-stops">
                {diagram.stops.map((stop) => (
                  <g class="nd-stop" data-part={stop.part} style={`--delay: ${stop.delay}s`}>
                    <path d={stop.stub} />
                    <path class="nd-cap" d={stop.cap} />
                  </g>
                ))}
              </g>

              <g class="nd-node">
                <path class="nd-ghost" d={diagram.node.body} />
                <path class="nd-tabs" d={diagram.node.tabs} />
                {diagram.node.eyes.map((eye) => (
                  <circle class="nd-eye" cx={eye.x} cy={eye.y} r={diagram.kind === "wide" ? 3 : 2.5} />
                ))}
                <text class="nd-name" x={diagram.node.center.x} y={diagram.node.center.y + type.name * 0.55} style={`font-size: ${type.name}px`}>
                  <tspan x={diagram.node.center.x} dy="-0.55em">
                    {nd.name[0]}
                  </tspan>
                  <tspan x={diagram.node.center.x} dy="1.2em">
                    {nd.name[1]}
                  </tspan>
                </text>
              </g>

              {diagram.parts.map((pill) => (
                <g class="nd-pill" data-part={pill.key} data-role={pill.role} data-tinted={pill.tinted ? "" : undefined}>
                  <rect x={pill.x} y={pill.y} width={pill.width} height={pill.height} rx="5" />
                  <text x={pill.x + type.pad} y={pill.y + pill.height / 2} style={`font-size: ${type.pill}px`}>
                    {nd.parts[pill.key]}
                  </text>
                </g>
              ))}

              {diagram.destinations.map((pill) => {
                const name = m.demo.calendars[pill.key]
                const projection = nd.projections[pill.projection]
                const avatarTop = pill.y + (pill.height - type.avatar) / 2
                const textX = pill.x + type.pad + type.avatar + 8
                return (
                  <g class="nd-pill nd-destination" data-destination={pill.key}>
                    <rect x={pill.x} y={pill.y} width={pill.width} height={pill.height} rx="5" />
                    <image
                      href={avatars[pill.key]}
                      x={pill.x + type.pad}
                      y={avatarTop}
                      width={type.avatar}
                      height={type.avatar}
                      clip-path={`url(#nd-${diagram.kind}-${pill.key})`}
                    />
                    {diagram.kind === "wide" ? (
                      <text x={textX} y={pill.y + pill.height / 2} style={`font-size: ${type.pill}px`}>
                        {format(nd.destination, { calendar: name, projection })}
                      </text>
                    ) : (
                      <text x={textX} y={pill.y + pill.height / 2} style={`font-size: ${type.pill}px`}>
                        <tspan x={textX} dy="-0.6em">
                          {name}
                        </tspan>
                        <tspan class="nd-projection" x={textX} dy="1.2em">
                          {projection}
                        </tspan>
                      </text>
                    )}
                  </g>
                )
              })}
            </svg>
          )
        })
      }

      <NodeDiagramControls client:load m={m.motion} />
    </figure>
  </div>
</section>

<style>
  .hh-e { padding-block: clamp(1.5rem, 4vh, 3rem) 0; }
  .hh-e-wrap { width: min(68rem, 100% - 2 * var(--hh-gutter)); margin-inline: auto; }
  .hh-e-copy h1 { margin: 0 0 1.25rem; font-size: clamp(2.5rem, 1.6rem + 3.4vw, 3.5rem); }

  /* From 1000px the headline and the pitch share one band over the diagram, so the whole diagram
     fits the first screen of a laptop. */
  @media (min-width: 1000px) {
    /* Besley's two lines stand a little taller than the face this hero was drawn with, so the
       band starts a little higher on short screens. */
    .hh-e { padding-top: clamp(1rem, 2.5vh, 3rem); }
    .hh-e-copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      column-gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
    .hh-e-copy h1 { margin: 0; }
  }
</style>
