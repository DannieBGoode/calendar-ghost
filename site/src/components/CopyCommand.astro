---
// One shell command with a Copy button, shared by every place that offers a command to copy.
// The button appears only with JavaScript; without the Clipboard API (plain HTTP on a LAN, older
// browsers) it selects the command so the visitor can copy it by hand.
import type { Messages } from "../i18n"

interface Props {
  m: Messages
  /** Unique on the page: the button finds its command by this id. */
  id: string
  command: string
}

const { m, id, command } = Astro.props
---

<div class="command">
  <code id={id}>{command}</code>
  <button
    type="button"
    class="btn btn-small"
    hidden
    data-copy={id}
    data-label={m.selfHost.copy}
    data-copied={m.selfHost.copied}
    data-selected={m.selfHost.selected}
  >
    {m.selfHost.copy}
  </button>
  <span class="sr-only" role="status" data-copy-status></span>
</div>

<script>
  // The result also goes to a visually hidden live region beside the button, since a button's
  // own text change is not reliably announced by screen readers.
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    const status = button.parentElement?.querySelector<HTMLElement>("[data-copy-status]")
    button.hidden = false
    button.addEventListener("click", async () => {
      const code = document.getElementById(button.dataset.copy ?? "")
      if (!code) return
      let message: string
      try {
        await navigator.clipboard.writeText(code.textContent ?? "")
        message = button.dataset.copied ?? ""
      } catch {
        const range = document.createRange()
        range.selectNodeContents(code)
        const selection = window.getSelection()
        selection?.removeAllRanges()
        selection?.addRange(range)
        message = button.dataset.selected ?? ""
      }
      button.textContent = message
      if (status) status.textContent = message
      window.setTimeout(() => {
        button.textContent = button.dataset.label ?? ""
        if (status) status.textContent = ""
      }, 2500)
    })
  }
</script>

<style>
  /* Flex children default to their content's width; a long command must not widen the page, so
     the command may shrink and scrolls inside its own box. */
  .command {
    display: flex; align-items: center; gap: 0.5rem; min-width: 0; padding: 0.6rem 0.6rem 0.6rem 0.9rem;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
  }
  .command code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font-size: 0.875rem; padding-block: 0.35rem; }
  .command .btn { flex: none; }
</style>
