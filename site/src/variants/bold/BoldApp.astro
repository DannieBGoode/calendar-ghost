---
// The app, feature by feature, with the ghost peeking over the top of its own Overview.
import type { Messages } from "../../i18n"
import { Ghost, SpeechBubble } from "../../islands/Ghost"
import AppFeatures from "../../sections/AppFeatures.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<AppFeatures m={m} class="b-section b-app" split>
  <div class="b-peek" aria-hidden="true" slot="health">
    <SpeechBubble side="left" className="b-peek-bubble">{m.variants.bold.app.ghost}</SpeechBubble>
    <Ghost face="surprised" then="happy" alive="brief" size={112} className="b-peek-ghost" />
  </div>
</AppFeatures>

<style>
  /* Bigger feature titles, in the page's scale. */
  :global(.bold .b-app) { --feat-title: var(--step-2); --feat-title-weight: 600; }

  /* The ghost peeks over the Overview's top edge, from behind it. */
  .b-peek { position: absolute; right: 12%; top: 0; z-index: 0; display: flex; align-items: center; gap: 0.5rem; transform: translateY(-62%); }
  .b-peek :global(.b-peek-bubble) { position: relative; inset: auto; transform: translateY(-1.25rem); }
  .b-peek :global(.b-peek-bubble)::before { top: calc(50% - 0.325rem); }
  :global(.b-app .feat-shot-health > .mock) { box-shadow: 0 40px 80px -48px color-mix(in oklch, var(--success-foreground), transparent 30%); }
  /* Room above the Overview for the ghost that peeks over it. */
  :global(.b-app .feat-shot-health) { margin-top: 4.5rem; }
  @media (max-width: 599px) {
    .b-peek { right: 4%; }
    .b-peek :global(.b-peek-ghost) { --ghost-size: 84px; }
  }

  /* Wakes surprised (caught peeking), then is happy to be seen. */
  @media (prefers-reduced-motion: no-preference) {
    .b-peek :global(.ghost[data-awake]) { animation: peek-up 900ms var(--ease-out-quart) both; }
  }
  @keyframes peek-up { from { transform: translateY(45%); } to { transform: none; } }
</style>
