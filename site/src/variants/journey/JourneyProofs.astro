---
// Stop 4: the proof. Every trust claim as an icon, a title that links to the documentation that
// proves it, and one sentence, in one two-column list.
import DocLink from "../../components/DocLink.astro"
import Icon from "../../components/Icon.astro"
import type { Messages } from "../../i18n"
import type { IconName } from "../../icons"
import { TRUST_DOCS } from "../../links"
import Stop from "./Stop.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
// One icon per claim, in the order of `trust.cards`.
const ICONS: readonly IconName[] = ["rotateCcw", "eye", "mailX", "refreshCwOff", "repeat", "listChecks", "shieldCheck", "activity"]
---

<section id="features" class="j-section j-proof" aria-labelledby="trust-title">
  <div class="j-wrap">
    <Stop m={m} n={4} name="proof" />
    <h2 id="trust-title">{m.trust.title}</h2>
    <p class="j-lead">{m.variants.journey.proof.lead}</p>
    <ul class="jp-list">
      {
        m.trust.cards.map((card, index) => (
          <li>
            <Icon name={ICONS[index] ?? "shieldCheck"} class="jp-icon" />
            <p>
              <strong>
                <DocLink m={m} href={TRUST_DOCS[index] ?? TRUST_DOCS[0]}>
                  {card.title}
                </DocLink>
              </strong>{" "}
              {card.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .j-proof h2 { max-width: 12ch; }
  .j-proof .j-lead { margin: 0; }
  .jp-list { list-style: none; margin: var(--space-lg) 0 0; padding: 0; display: grid; gap: 1.25rem 3rem; }
  .jp-list li { display: flex; gap: 0.85rem; align-items: flex-start; min-width: 0; padding-top: 1.1rem; border-top: 1px solid var(--border); }
  .jp-list p { margin: 0; color: var(--muted-foreground); }
  .jp-list strong { color: var(--foreground); }
  .jp-list :global(.jp-icon) {
    flex: none; width: 2.25rem; height: 2.25rem; padding: 0.5rem; border-radius: 50%;
    background: var(--primary-soft); color: var(--primary);
  }
  @media (min-width: 900px) { .jp-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
