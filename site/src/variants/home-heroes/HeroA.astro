---
// Hero A, a quieter /bold: the pitch in a narrow column on the left, and on the right Sam's week,
// larger and cropped, running off the page's edge. The sweep heads left first, so what work sees
// (Busy, Busy, Busy) fills the frame within the first seconds; the labels ride the divider.
import { WideReveal } from "../../islands/WideReveal"
import type { Messages } from "../../i18n"
import HeroPitch from "./HeroPitch.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
const [firstLine, secondLine] = m.variants.bold.hero.titleLines
---

<section class="hh hh-a" aria-labelledby="hero-title">
  <div class="hh-a-grid">
    <div class="hh-a-copy">
      <h1 id="hero-title"><span>{firstLine}</span> <span class="hh-accent">{secondLine}</span></h1>
      <HeroPitch m={m} />
    </div>
    <div class="hh-a-demo">
      <WideReveal
        client:load
        m={m.demo}
        motion={m.motion}
        weekHeight={480}
        phoneWeekHeight={320}
        handleSize={108}
        phoneHandleSize={84}
        ghostTone="mist"
        sweep={{ rest: 40, direction: "left", swing: 30 }}
        labels="divider"
        handleHint={m.variants.homeHeroes.handleHint}
      />
    </div>
  </div>
</section>

<style>
  .hh-a { overflow-x: clip; padding-block: clamp(1.5rem, 4vh, 3rem) 0; }
  .hh-a-grid {
    display: grid; row-gap: 2rem;
    grid-template-columns: var(--hh-gutter) minmax(0, 1fr) var(--hh-gutter);
  }
  .hh-a-copy { grid-column: 2; min-width: 0; }
  .hh-a-demo { grid-column: 1 / -1; min-width: 0; }
  .hh-a-copy h1 { margin: 0 0 1.25rem; font-size: clamp(2.5rem, 1.6rem + 3.4vw, 3.5rem); }
  .hh-a-demo :global(.reveal) { margin: 0; }
  .hh-a-demo :global(.reveal-frame) { border-radius: 0; border-inline: 0; }

  /* Sam's week, about a third larger than on the home page: readable events, and three days and a
     bit of the fourth in view, so the week plainly carries on past the edge. */
  @media (min-width: 640px) {
    .hh-a-demo :global(.reveal-week) { width: max(100%, 13rem * 5); }
    .hh-a-demo :global(.cal-event) { padding: 5px 9px; font-size: 0.875rem; }
    .hh-a-demo :global(.cal-event > small) { font-size: 0.8125rem; }
    .hh-a-demo :global(.week-days) { font-size: 0.8125rem; }
  }

  /* Side by side: the copy in a column about 30rem wide; the week takes the rest and runs off the
     right edge. */
  @media (min-width: 960px) {
    .hh-a { padding-top: clamp(2rem, 5vh, 3.5rem); }
    .hh-a-grid {
      column-gap: 0;
      grid-template-columns:
        max(var(--hh-gutter), (100% - 72rem) / 2) minmax(0, clamp(26rem, 13rem + 20vw, 30rem))
        clamp(2rem, 4vw, 4rem) minmax(0, 1fr);
      align-items: center;
    }
    .hh-a-copy { grid-column: 2; }
    .hh-a-demo { grid-column: 4; }
    .hh-a-demo :global(.reveal-frame) {
      border-inline: 1px solid var(--border); border-right: 0; border-radius: var(--panel-radius) 0 0 var(--panel-radius);
    }
  }
</style>
