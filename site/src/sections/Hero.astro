---
import { WideReveal } from "../islands/WideReveal"
import type { Messages } from "../i18n"
import { REPO_URL } from "../links"

interface Props {
  m: Messages
}

const { m } = Astro.props
// One sentence per line. The copy is shared with /bold until one design is chosen.
const [firstLine, secondLine] = m.variants.bold.hero.titleLines
---

<section class="hero section" aria-labelledby="hero-title">
  <div class="container hero-copy">
    <h1 id="hero-title"><span>{firstLine}</span> <span>{secondLine}</span></h1>
    <div class="ctas">
      <a class="btn btn-primary" href="#self-host">{m.hero.primary}</a>
      <a class="btn" href={REPO_URL} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">★</span> {m.hero.secondary}<span class="sr-only"> {m.nav.newTab}</span>
      </a>
    </div>
  </div>
  <div class="container">
    <WideReveal client:load m={m.demo} motion={m.motion} />
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 6vw, 5rem); }
  .hero-copy { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .hero-copy h1 { margin-bottom: 1.75rem; }
  .hero-copy h1 span { display: block; }
  .hero-copy .ctas { justify-content: center; }
</style>
