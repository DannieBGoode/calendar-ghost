---
// Right after the night band, a close beat: one event, and the choice of what crosses with it. The
// parts that always stay behind sit on the Personal card inside the demo (islands/Crossing.tsx).
import { avatarUrls } from "../../avatars"
import { Crossing } from "../../islands/Crossing"
import type { Messages } from "../../i18n"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<section class="b-section b-close b-crossing" aria-labelledby="crossing-title">
  <div class="b-wrap">
    <h2 id="crossing-title">{m.crossing.title}</h2>
    <div class="b-crossing-demo">
      <Crossing
        client:visible
        m={{ crossing: m.crossing, demo: m.demo, motion: m.motion }}
        avatars={await avatarUrls()}
      />
    </div>
  </div>
</section>

<style>
  .b-crossing h2 { max-width: 14ch; }
  .b-crossing-demo { margin-top: var(--space-lg); }
  .b-crossing :global(.crossing-switch button) { font-size: 1rem; padding-inline: 1.25rem; }
  .b-crossing :global(.crossing-explain) { font-size: var(--step-1); font-family: var(--font-display); font-style: italic; }
</style>
