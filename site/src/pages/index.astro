---
import Layout from "../layouts/Layout.astro"
import { messagesFor } from "../i18n"
import { homeStructuredData, jsonLd } from "../lib/structured-data"
import AppFeatures from "../sections/AppFeatures.astro"
import CompatibleCalendars from "../sections/CompatibleCalendars.astro"
import CrossingSection from "../sections/CrossingSection.astro"
import Faq from "../sections/Faq.astro"
import Footer from "../sections/Footer.astro"
import Hero from "../sections/Hero.astro"
import HowItWorksStrip from "../sections/HowItWorksStrip.astro"
import Integrations from "../sections/Integrations.astro"
import Nav from "../sections/Nav.astro"
import SelfHost from "../sections/SelfHost.astro"
import Trust from "../sections/Trust.astro"
import Week from "../sections/Week.astro"
import Why from "../sections/Why.astro"

const m = messagesFor(Astro.currentLocale)
const structuredData = jsonLd(homeStructuredData(m, Astro.site ?? new URL("https://calendarghost.com")))
---

<Layout title={m.meta.title} description={m.meta.description}>
  <script slot="head" type="application/ld+json" is:inline set:html={structuredData} />
  <Nav m={m} />
  <main>
    <Hero m={m} />
    <HowItWorksStrip m={m} />
    <CompatibleCalendars m={m} />
    <Week m={m} />
    <CrossingSection m={m} />
    <AppFeatures m={m} />
    <Trust m={m} />
    <Integrations m={m} />
    <SelfHost m={m} />
    <Why m={m} />
    <Faq m={m} />
  </main>
  <Footer m={m} />
</Layout>
