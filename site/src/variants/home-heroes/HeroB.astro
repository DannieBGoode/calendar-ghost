---
// Hero B, one event, big: no week. The headline runs across the top; under it, the pitch on the
// left and, on the right, Sam's Dentist appointment as a large card. The ghost carries it to Work,
// where it lands as Busy 15:00 to 16:30, while the guest and the meeting link stay behind. The
// carry is /journey's crossing island, given this hero's own composition and scale.
import "../journey/crossing.css"
import { avatarUrls } from "../../avatars"
import type { Messages } from "../../i18n"
import { JourneyCrossing } from "../journey/JourneyCrossing"
import { journeyDentist } from "../journey/plans"
import HeroPitch from "./HeroPitch.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
const [firstLine, secondLine] = m.variants.bold.hero.titleLines
---

<section class="hh hh-b" aria-labelledby="hero-title">
  <div class="hh-b-grid">
    <h1 id="hero-title"><span>{firstLine}</span> <span class="hh-accent">{secondLine}</span></h1>
    <div class="hh-b-pitch">
      <HeroPitch m={m} />
    </div>
    <div class="hh-b-demo">
      <JourneyCrossing
        client:load
        compactToggle
        firstRestMs={1200}
        m={{
          switchLabel: m.crossing.switchLabel,
          busyOnly: m.crossing.busyOnly,
          withDetails: m.crossing.withDetails,
          busyOnlyBody: m.crossing.busyOnlyBody,
          withDetailsBody: m.crossing.withDetailsBody,
          peel: m.variants.journey.crossing.peel,
          busySays: m.ghost.crossingBusy,
          detailsSays: m.ghost.crossingDetails,
          busy: m.demo.busy,
          summary: m.crossing.summary,
          day: m.demo.days[0],
          calendars: m.demo.calendars,
          motion: m.motion,
        }}
        plan={journeyDentist(m)}
        avatars={await avatarUrls()}
      />
    </div>
  </div>
</section>

<style>
  .hh-b { padding-block: clamp(1.5rem, 4vh, 3rem) 0; }
  .hh-b-grid { width: min(72rem, 100% - 2 * var(--hh-gutter)); margin-inline: auto; display: grid; gap: 1.5rem; }
  .hh-b h1 { margin: 0; font-size: clamp(2.5rem, 1.4rem + 3.2vw, 4rem); }
  .hh-b-demo { min-width: 0; margin-top: 1rem; }

  /* The crossing at this hero's scale: no panel of its own (it sits on the page), a large card
     for the plan, a smaller ghost, and the pause control as an icon beside the switch. */
  .hh-b-demo :global(.jc) { --jc-ghost: 112px; padding: 0; background: none; border-radius: 0; font-size: 0.9375rem; }
  .hh-b-demo :global(.jc .ghost) { --ghost-cutout: var(--background); }
  .hh-b-demo :global(.jc-controls) { gap: 0.75rem 1.5rem; margin-bottom: 1.25rem; }
  .hh-b-demo :global(.jc-toggle) { align-self: flex-end; }
  .hh-b-demo :global(.jc-title) { font: 600 clamp(1.5rem, 1.2rem + 1vw, 2rem)/1.1 var(--font-display); letter-spacing: -0.02em; }
  .hh-b-demo :global(.jc-card) { gap: 0.5rem; padding: 1rem 1.1rem 1.1rem; }
  .hh-b-demo :global(.jc-card-busy) { padding: 1rem 1.1rem; }
  .hh-b-demo :global(.jc-card-busy b) { font: 600 clamp(1.5rem, 1.2rem + 1vw, 2rem)/1.1 var(--font-display); }
  .hh-b-demo :global(.jc-row) { font-size: 0.9375rem; }
  .hh-b-demo :global(.jc-pill) { font-size: 0.875rem; }
  .hh-b-demo :global(.jc-explain) { font-size: var(--step-1); }

  /* Side by side: the pitch in a narrow column, the crossing beside it. The sentence that says
     what crosses over sits under the switch, so the space between the calendars is the ghost's
     alone; what it says rises above it. */
  @media (min-width: 960px) {
    .hh-b-grid {
      grid-template-columns: minmax(0, clamp(18rem, 1rem + 24vw, 20rem)) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 4rem); row-gap: 2rem;
    }
    .hh-b h1 { grid-column: 1 / -1; }
    .hh-b h1 > span { display: inline; }
    .hh-b-pitch { grid-column: 1; align-self: start; padding-top: 0.25rem; }
    .hh-b-demo { grid-column: 2; margin-top: 0; }
    .hh-b-demo :global(.jc) {
      grid-template-columns: minmax(0, 16rem) minmax(8rem, 1fr) minmax(0, 11rem);
    }
    .hh-b-pitch :global(.hh-btn) { padding-inline: 1rem; }
    .hh-b-pitch :global(.hh-meta) { text-wrap: balance; }
    .hh-b-demo :global(.jc-explain) {
      grid-column: 1 / -1; grid-row: 2; justify-self: start; align-self: start; max-width: none;
      margin: -0.25rem 0 1.5rem; padding: 0; text-align: left;
    }
    .hh-b-demo :global(.jc-from), .hh-b-demo :global(.jc-arc), .hh-b-demo :global(.jc-to), .hh-b-demo :global(.jc-ghost) { grid-row: 3; }
    .hh-b-demo :global(.jc-ghost) { justify-self: center; margin: 4.5rem 0 0; }
    .hh-b-demo :global(.jc .jc-says-land) {
      top: auto; bottom: calc(100% + 0.5rem); left: 50%; right: auto; max-width: 13rem; transform: translateX(-50%);
    }
    .hh-b-demo :global(.jc .jc-says-land::before) { top: auto; bottom: -0.36rem; left: calc(50% - 0.325rem); right: auto; transform: rotate(-45deg); }
  }
  @media (min-width: 1200px) {
    .hh-b-demo :global(.jc) { grid-template-columns: minmax(0, 17.5rem) minmax(8rem, 1fr) minmax(0, 13rem); }
  }
</style>
