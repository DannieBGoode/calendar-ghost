---
// Variant A of the landing page: one journey. The ghost carries one of Sam's plans down the page,
// and every section is a stop on the way. Kept for side-by-side comparison, so it is not indexed
// and stays out of the sitemap. It tries its own display typeface, Young Serif, loaded only here.
import "@fontsource/young-serif/400.css"
import youngSerifLatinWoff2 from "@fontsource/young-serif/files/young-serif-latin-400-normal.woff2?url"
import figtreeLatinWoff2 from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url"
import "../variants/journey/journey.css"
import "../variants/journey/crossing.css"
import VersionsLink from "../components/VersionsLink.astro"
import Layout from "../layouts/Layout.astro"
import { messagesFor } from "../i18n"
import { Ghost } from "../islands/Ghost"
import Integrations from "../sections/Integrations.astro"
import Nav from "../sections/Nav.astro"
import Carried from "../variants/journey/Carried.astro"
import JourneyApp from "../variants/journey/JourneyApp.astro"
import JourneyEnding from "../variants/journey/JourneyEnding.astro"
import JourneyFaq from "../variants/journey/JourneyFaq.astro"
import JourneyHero from "../variants/journey/JourneyHero.astro"
import JourneyProofs from "../variants/journey/JourneyProofs.astro"
import JourneySelfHost from "../variants/journey/JourneySelfHost.astro"
import JourneyWeek from "../variants/journey/JourneyWeek.astro"
import JourneyWhy from "../variants/journey/JourneyWhy.astro"
import Stop from "../variants/journey/Stop.astro"

const m = messagesFor(Astro.currentLocale)
---

<Layout title={m.meta.title} description={m.meta.description} noindex preloadFonts={[figtreeLatinWoff2, youngSerifLatinWoff2]}>
  <div class="journey">
    <Nav m={m} base="/journey" />
    <main>
      <JourneyHero m={m} />
      <div class="j-route">
        <!-- On wide screens, the ghost rides down the margin with the Dentist from the hero. -->
        <div class="j-rail" aria-hidden="true">
          <div class="j-rail-ghost">
            <div class="j-rail-carrier">
              <Ghost face="happy" size={72} />
              <Carried m={m} />
            </div>
          </div>
        </div>
        <JourneyWeek m={m} />
        <JourneyWhy m={m} />
        <JourneyProofs m={m} />
        <Integrations m={m} class="j-section">
          <Stop m={m} n={5} name="homelab" slot="eyebrow" />
        </Integrations>
        <JourneyApp m={m} />
        <JourneySelfHost m={m} />
        <JourneyFaq m={m} />
      </div>
    </main>
    <JourneyEnding m={m} />
  </div>
  <VersionsLink />
</Layout>
