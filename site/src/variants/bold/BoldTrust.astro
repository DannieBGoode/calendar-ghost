---
// Built to be trusted: every claim as text, an icon, and a link to the doc that proves it, in a
// two-column checklist.
import DocLink from "../../components/DocLink.astro"
import Icon from "../../components/Icon.astro"
import "./trust.css"
import type { Messages } from "../../i18n"
import type { IconName } from "../../icons"
import { TRUST_DOCS } from "../../links"

interface Props {
  m: Messages
}

const { m } = Astro.props
// One icon per claim, in the order of `trust.cards`.
const ICONS: readonly IconName[] = [
  "rotateCcw",
  "eye",
  "mailX",
  "refreshCwOff",
  "repeat",
  "listChecks",
  "shieldCheck",
  "activity",
]
---

<section id="features" class="b-section b-trust" aria-labelledby="trust-title">
  <div class="b-wrap">
    <h2 id="trust-title">{m.trust.title}</h2>
    <ul class="b-checklist">
      {
        m.trust.cards.map((card, index) => (
          <li>
            <Icon name={ICONS[index] ?? "shieldCheck"} class="b-check-icon" />
            <p>
              <strong><DocLink m={m} href={TRUST_DOCS[index] ?? TRUST_DOCS[0]}>{card.title}</DocLink></strong> {card.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
