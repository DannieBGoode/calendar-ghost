---
// A home page iteration: the home page's own sections in the same order, under another hero (the
// page's slot). Each iteration is its own route under /home/, kept for side-by-side comparison, so
// it is not indexed and stays out of the sitemap. `/` itself does not use this shell, so a change
// here never touches iteration 1.
import "./heroes.css"
import Layout from "../../layouts/Layout.astro"
import { messagesFor } from "../../i18n"
import AppFeatures from "../../sections/AppFeatures.astro"
import CrossingSection from "../../sections/CrossingSection.astro"
import Faq from "../../sections/Faq.astro"
import Footer from "../../sections/Footer.astro"
import HowItWorksStrip from "../../sections/HowItWorksStrip.astro"
import Integrations from "../../sections/Integrations.astro"
import Nav from "../../sections/Nav.astro"
import SelfHost from "../../sections/SelfHost.astro"
import Trust from "../../sections/Trust.astro"
import Week from "../../sections/Week.astro"
import Why from "../../sections/Why.astro"

interface Props {
  /** The iteration's route, so the section links jump within it. */
  path: string
}

const { path } = Astro.props
const m = messagesFor(Astro.currentLocale)
---

<Layout title={m.meta.title} description={m.meta.description} noindex>
  <Nav m={m} base={path} />
  <main>
    <slot />
    <HowItWorksStrip m={m} />
    <Week m={m} />
    <CrossingSection m={m} />
    <AppFeatures m={m} />
    <Trust m={m} />
    <Integrations m={m} />
    <SelfHost m={m} />
    <Why m={m} />
    <Faq m={m} />
  </main>
  <Footer m={m} />
</Layout>
