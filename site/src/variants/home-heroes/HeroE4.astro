---
// Hero E4: hero E3, compacted and looping. The copy (headline, one line, the calls to action)
// stacks above the diagram. Over the whole diagram, a switch: what work sees, or what Sam sees.
// On the left, "Your calendars": Sam's three calendars as pills, Work's in its own red. In the
// middle, the ghost. On the right, a short day: Sam's Work calendar, or Sam's Personal calendar.
// A chip carrying an event's title leaves each pill and goes through the ghost. Bound for Work,
// the gym session and the family dinner lose their titles there, which the ghost keeps back (small
// chips under "Kept from Work"), and leave as indigo "Busy" chips; Work's own client call passes
// with its title. Bound for Personal, every title stays. Each hairline brightens while a chip runs
// along it. Each lands in the day at its time, the day rests, and the cycle starts again. Geometry
// and timing come from hub-e4.ts; the motion is CSS (hub-e4.css and the keyframes made here).
// Without JavaScript or with reduced motion the diagram stands still with everything landed.
import "./hub-e4.css"
import EyeOff from "lucide-static/icons/eye-off.svg?raw"
import { avatarUrls } from "../../avatars"
import type { Messages } from "../../i18n"
import { format } from "../../i18n/format"
import { Ghost } from "../../islands/Ghost"
import { REPO_URL } from "../../links"
import { HubE4Controls } from "./HubE4Controls"
import {
  buildHub,
  chipStops,
  clock,
  dropStops,
  faceStops,
  keyframes,
  lineStops,
  SOURCES,
  showsOnWork,
  stayStops,
  type CalendarKey,
  type EventKey,
  type Hub,
  type Leg,
} from "./hub-e4"

interface Props {
  m: Messages
}

const { m } = Astro.props
const [firstLine, secondLine] = m.variants.bold.hero.titleLines
const hc = m.variants.homeHeroes.hubE4
const avatars = await avatarUrls()
const hubs: Hub[] = [buildHub("wide"), buildHub("tall")]

const calendarName = (key: CalendarKey) => m.demo.calendars[key]
const eventTitle = (key: EventKey) => (key === "familyDinner" ? hc.events.familyDinner : m.demo.events[key].title)

const facts = [
  ...SOURCES.map((source) =>
    format(showsOnWork(source) === "busy" ? hc.busyFact : hc.ownFact, {
      event: eventTitle(source.event.key),
      from: calendarName(source.key),
      start: clock(source.event.start),
      end: clock(source.event.end),
    }),
  ),
  hc.never,
  hc.youFact,
]

/** Each layout's sizes, in diagram units (the pills' are hero E2's). */
const TYPE = {
  wide: { label: 13.5, name: 16.5, event: 13, avatar: 26, pad: 14, dayAvatar: 28, dayName: 16.5, account: 12.5, block: 12.5, hour: 10.5, chip: 11.5, kept: 11 },
  tall: { label: 12, name: 13.5, event: 11.5, avatar: 18, pad: 9, dayAvatar: 22, dayName: 14, account: 11.5, block: 11.5, hour: 9.5, chip: 10.5, kept: 10 },
} as const

/** A chip's size for its label: about half an em per letter, plus its padding. */
const chipSize = (label: string, size: number, extra = 0) => ({ width: Math.round(label.length * size * 0.56 + size * 1.5 + extra), height: Math.round(size * 1.8) })
const sourceTitle = (leg: Leg, hub: Hub) => eventTitle(hub.pills.find((pill) => pill.key === leg.source)!.event.key)
const pct = (value: number, of: number) => `${Math.round((value / of) * 10000) / 100}%`
/** Lucide's eye-off, as its path data, drawn inside the kept chips. */
const eyeOff = [...EyeOff.matchAll(/ d="([^"]+)"/g)].map((match) => match[1]!)

/** Every element that moves gets its own keyframes for one whole cycle, so the loop needs no
 * script: chips along their hairlines, the hairlines brightening, titles dropping, blocks and kept
 * titles landing and going, and the ghost's face. All are named `hc-`. */
const motion = hubs.map((hub) => {
  const rules: string[] = []
  const name = (part: string, index: number) => `hc-${hub.kind}-${part}-${index}`
  const legs = hub.legs.map((leg, index) => {
    rules.push(keyframes(name("chip", index), chipStops(hub, leg)), keyframes(name("line", index), lineStops(hub, leg.delay, leg.duration)))
    if (leg.drops) rules.push(keyframes(name("drop", index), dropStops(hub, leg)))
    return { chip: name("chip", index), line: name("line", index), drop: leg.drops ? name("drop", index) : undefined }
  })
  const blocks = hub.blocks.map((block, index) => {
    rules.push(keyframes(name("block", index), stayStops(hub, block.lands)))
    return name("block", index)
  })
  const kept = hub.kept.titles.map((title, index) => {
    rules.push(keyframes(name("kept", index), stayStops(hub, title.appears)))
    return name("kept", index)
  })
  const caption = name("caption", 0)
  rules.push(keyframes(caption, stayStops(hub, Math.min(...hub.kept.titles.map((title) => title.appears)))))
  const face = faceStops(hub)
  rules.push(
    keyframes(`hc-${hub.kind}-face-then`, face),
    keyframes(`hc-${hub.kind}-face-first`, face.map(([percent, values]) => [percent, { opacity: 1 - Number(values.opacity) }])),
  )
  return { legs, blocks, kept, caption, css: rules.join("") }
})
const motionCss = motion.map((item) => item.css).join("")
---

<section class="hh hh-e4" aria-labelledby="hero-title">
  <div class="hh-e4-wrap">
    <div class="hh-e4-copy">
      <h1 id="hero-title"><span>{firstLine}</span> <span class="hh-accent">{secondLine}</span></h1>
      <p class="hh-line">{hc.line}</p>
      <div class="ctas hh-ctas">
        <a class="btn btn-primary hh-btn" href="#self-host">{m.hero.primary}</a>
        <a class="btn hh-btn" href={REPO_URL} target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">★</span> {m.hero.secondary}<span class="sr-only"> {m.nav.newTab}</span>
        </a>
      </div>
    </div>

    <figure class="hc" data-playing="true" data-view="work" aria-labelledby="hc-summary">
      <figcaption id="hc-summary" class="sr-only">{hc.summary}</figcaption>
      <ul class="sr-only">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>
      <p class="hc-static-view" aria-hidden="true">{m.demo.workSees}</p>

      {
        hubs.map((hub, layout) => {
          const type = TYPE[hub.kind]
          const wide = hub.kind === "wide"
          const id = (name: string) => `hc-${hub.kind}-${name}`
          const { day } = hub
          const timing = motion[layout]!
          const dayMiddle = day.y + day.header / 2
          const dayTextX = day.x + type.pad + type.dayAvatar + 10
          const keptChip = (title: string) => chipSize(title, type.kept, type.kept * 1.4)
          return (
            <div class={`hc-layout hc-${hub.kind}`} style={`--hc-cycle: ${hub.cycle}s`}>
              <svg class="hc-svg" viewBox={`0 0 ${hub.width} ${hub.height}`} aria-hidden="true" focusable="false">
                <defs>
                  {hub.pills.map((pill) => (
                    <clipPath id={id(pill.key)}>
                      <circle cx={pill.x + type.pad + type.avatar / 2} cy={pill.y + pill.height / 2} r={type.avatar / 2} />
                    </clipPath>
                  ))}
                  <clipPath id={id("day")}>
                    <circle cx={day.x + type.pad + type.dayAvatar / 2} cy={dayMiddle} r={type.dayAvatar / 2} />
                  </clipPath>
                </defs>

                <text class="hc-label" x={hub.labels.calendars.x} y={hub.labels.calendars.y} style={`font-size: ${type.label}px`}>
                  {hc.calendarsLabel}
                </text>
                <text class="hc-label hc-as-work" x={hub.labels.day.x} y={hub.labels.day.y} style={`font-size: ${type.label}px`}>
                  {hc.dayLabels.work}
                </text>
                <text class="hc-label hc-as-you" x={hub.labels.day.x} y={hub.labels.day.y} style={`font-size: ${type.label}px`}>
                  {hc.dayLabels.you}
                </text>

                <g class="hc-curves">
                  {hub.curves.map((curve) => (
                    <path d={curve.d} data-curve={curve.id} />
                  ))}
                </g>
                <g class="hc-lit">
                  {hub.legs.map((leg, index) => (
                    <path d={leg.d} data-source={leg.source} data-shows={leg.shows} style={`--hc-anim: ${timing.legs[index]!.line}`} />
                  ))}
                </g>

                {hub.pills.map((pill) => {
                  const middle = pill.y + pill.height / 2
                  const textX = pill.x + type.pad + type.avatar + (wide ? 11 : 7)
                  const line = wide ? 9 : 7.5
                  const title = eventTitle(pill.event.key)
                  const event = wide ? format(hc.eventLine, { event: title, time: clock(pill.event.start) }) : title
                  return (
                    <g class="hc-pill" data-calendar={pill.key}>
                      <rect x={pill.x} y={pill.y} width={pill.width} height={pill.height} rx="6" />
                      <circle class="hc-ring" cx={pill.x + type.pad + type.avatar / 2} cy={middle} r={type.avatar / 2 + 2} />
                      <image href={avatars[pill.key]} x={pill.x + type.pad} y={middle - type.avatar / 2} width={type.avatar} height={type.avatar} clip-path={`url(#${id(pill.key)})`} />
                      <text x={textX} y={middle} style={`font-size: ${type.name}px`}>
                        <tspan x={textX} dy={-line}>
                          {calendarName(pill.key)}
                        </tspan>
                        <tspan class="hc-muted" x={textX} dy={line * 2} style={`font-size: ${type.event}px`}>
                          {event}
                        </tspan>
                      </text>
                    </g>
                  )
                })}

                <g class="hc-day">
                  <rect class="hc-box" x={day.x} y={day.y} width={day.width} height={day.height} rx="8" />
                  {(["work", "personal"] as const).map((calendar) => (
                    <g class={`hc-head ${calendar === "work" ? "hc-as-work" : "hc-as-you"}`} data-calendar={calendar}>
                      <image href={avatars[calendar]} x={day.x + type.pad} y={dayMiddle - type.dayAvatar / 2} width={type.dayAvatar} height={type.dayAvatar} clip-path={`url(#${id("day")})`} />
                      <text x={dayTextX} y={dayMiddle} style={`font-size: ${type.dayName}px`}>
                        <tspan class="hc-name" x={dayTextX} dy={-type.dayName * 0.5}>
                          {m.demo.calendars[calendar]}
                        </tspan>
                        <tspan class="hc-muted" x={dayTextX} dy={type.dayName * 1.05} style={`font-size: ${type.account}px`}>
                          {m.app.rules.accounts[calendar]}
                        </tspan>
                      </text>
                    </g>
                  ))}
                  <path class="hc-rule" d={`M${day.x} ${day.y + day.header}h${day.width}`} />
                  {hub.hours.map(({ y, hour }) => (
                    <>
                      <path class="hc-hour" d={`M${day.x + day.gutter - 6} ${y}H${day.x + day.width - 1}`} />
                      <text class="hc-hour-label" x={day.x + day.gutter - 10} y={y} style={`font-size: ${type.hour}px`}>
                        {clock(hour)}
                      </text>
                    </>
                  ))}
                  {hub.blocks.map((block, index) => {
                    const middle = block.y + block.height / 2
                    const textX = block.x + (wide ? 19 : 15)
                    const time = `${clock(block.event.start)}–${clock(block.event.end)}`
                    const title = eventTitle(block.event.key)
                    return (
                      <g class="hc-block" data-source={block.source} data-event={block.event.key} data-shows={block.shows} style={`--hc-anim: ${timing.blocks[index]}`}>
                        <rect class="hc-paint" x={block.x} y={block.y} width={block.width} height={block.height} rx="4" />
                        {block.shows === "busy" && <rect class="hc-paint hc-paint-you" x={block.x} y={block.y} width={block.width} height={block.height} rx="4" />}
                        <circle class="hc-source-dot" cx={block.x + (wide ? 10 : 8)} cy={middle} r={wide ? 3.5 : 3} />
                        <text class={block.shows === "busy" ? "hc-as-work" : undefined} x={textX} y={middle} style={`font-size: ${type.block}px`}>
                          <tspan class="hc-block-title">{block.shows === "busy" ? m.demo.busy : title}</tspan>
                          <tspan class="hc-muted" dx="0.6em">
                            {time}
                          </tspan>
                        </text>
                        {block.shows === "busy" && (
                          <text class="hc-as-you" x={textX} y={middle} style={`font-size: ${type.block}px`}>
                            <tspan class="hc-block-title">{title}</tspan>
                            <tspan class="hc-muted" dx="0.6em">
                              {time}
                            </tspan>
                          </text>
                        )}
                      </g>
                    )
                  })}
                </g>

                <g class="hc-kept" style={`font-size: ${type.kept}px`}>
                  <text class="hc-kept-caption" x={hub.kept.caption.x} y={hub.kept.caption.y} text-anchor={wide ? "middle" : "end"} style={`--hc-anim: ${timing.caption}`}>
                    {hc.kept}
                  </text>
                  {hub.kept.titles.map((kept, index) => {
                    const title = eventTitle(kept.event)
                    const chip = keptChip(title)
                    const left = wide ? kept.x - chip.width / 2 : kept.x - chip.width
                    const icon = type.kept * 1.05
                    return (
                      <g class="hc-kept-title" data-source={kept.source} style={`--hc-anim: ${timing.kept[index]}`}>
                        <rect x={left} y={kept.y - chip.height / 2} width={chip.width} height={chip.height} rx={chip.height / 2} />
                        <g class="hc-eye" transform={`translate(${left + type.kept * 0.6} ${kept.y - icon / 2}) scale(${icon / 24})`}>
                          {eyeOff.map((d) => (
                            <path d={d} />
                          ))}
                        </g>
                        <text x={left + type.kept * 0.6 + icon + type.kept * 0.4} y={kept.y}>
                          {title}
                        </text>
                      </g>
                    )
                  })}
                </g>

                <g class="hc-chips">
                  {hub.legs.map((leg, index) => {
                    const title = sourceTitle(leg, hub)
                    const busy = leg.shows === "busy"
                    const chip = chipSize(title, type.chip)
                    const drop = timing.legs[index]!.drop
                    return (
                      <g
                        class="hc-chip"
                        data-source={leg.source}
                        data-side={leg.side}
                        data-shows={leg.shows}
                        data-drops={leg.drops ? "" : undefined}
                        style={`offset-path: path('${leg.d}'); --hc-anim: ${timing.legs[index]!.chip}`}
                      >
                        <rect x={-chip.width / 2} y={-chip.height / 2} width={chip.width} height={chip.height} rx={chip.height / 2} />
                        {busy ? (
                          <>
                            <text class="hc-as-work" x="0" y="0" style={`font-size: ${type.chip}px`}>
                              {m.demo.busy}
                            </text>
                            <text class="hc-as-you" x="0" y="0" style={`font-size: ${type.chip}px`}>
                              {title}
                            </text>
                          </>
                        ) : (
                          <text class="hc-chip-title" x="0" y="0" style={`font-size: ${type.chip}px${drop ? `; --hc-drop: ${drop}` : ""}`}>
                            {title}
                          </text>
                        )}
                      </g>
                    )
                  })}
                </g>
              </svg>
              <span class="hc-ghost" style={`left: ${pct(hub.ghost.x, hub.width)}; top: ${pct(hub.ghost.y, hub.height)}; width: ${pct(hub.ghost.width, hub.width)}`}>
                <Ghost face="neutral" then="happy" tone="mist" alive="still" />
              </span>
            </div>
          )
        })
      }

      <HubE4Controls client:load m={{ views: { work: m.demo.workSees, you: m.demo.youSee }, viewLabel: hc.viewLabel, motion: m.motion }} />
    </figure>
  </div>
</section>

<style is:inline set:html={motionCss}></style>

<style>
  .hh-e4 { padding-block: clamp(1.25rem, 3vh, 2.25rem) 0; overflow-x: clip; }
  .hh-e4-wrap { width: min(68rem, 100% - 2 * var(--hh-gutter)); margin-inline: auto; }
  .hh-e4-copy h1 { margin: 0 0 1rem; font-size: clamp(2.5rem, 1.6rem + 3.4vw, 3.5rem); letter-spacing: -0.01em; }
  .hh-e4-copy .hh-line { max-width: 44rem; text-wrap: balance; }
  .hh-e4-copy .hh-ctas { margin-top: 1.25rem; }
</style>
