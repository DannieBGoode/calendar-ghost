---
import type { Messages } from "../../i18n"
import { Ghost, SpeechBubble } from "../../islands/Ghost"

interface Props {
  m: Messages
}

const { m } = Astro.props
const [opening, ...rest] = m.why.body
---

<section class="b-section b-close b-short b-why" aria-labelledby="why-title">
  <div class="b-narrow b-why-grid">
    <div class="b-why-ghost" aria-hidden="true">
      <div class="b-says b-says-up">
        <Ghost face="wink" tone="lantern" alive="brief" float size={132} />
        <SpeechBubble side="top">{m.variants.bold.why.ghost}</SpeechBubble>
      </div>
    </div>
    <div>
      <h2 id="why-title">{m.why.title}</h2>
      <p class="b-why-opening">{opening}</p>
      {rest.map((paragraph) => <p>{paragraph}</p>)}
      <p class="b-signature">{m.why.signature}</p>
    </div>
  </div>
</section>

<style>
  .b-why-grid { display: grid; gap: var(--space-lg); }
  @media (min-width: 900px) {
    .b-why-grid { grid-template-columns: 12rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
    .b-why-ghost { padding-top: 6rem; }
  }
  .b-why-ghost .b-says { flex-direction: column-reverse; align-items: center; }
  .b-why-ghost :global(.speech-bubble)::before { left: calc(50% - 0.325rem) !important; }
  .b-why-opening {
    font: 420 clamp(1.5rem, 1.3rem + 0.7vw, 1.875rem)/1.35 var(--font-display); letter-spacing: -0.01em; color: var(--foreground);
    font-variation-settings: "SOFT" 100; max-width: 34ch;
  }
  .b-why p:not(.b-why-opening):not(.b-signature) { color: var(--muted-foreground); }
  .b-signature { font: italic 600 var(--step-1)/1.3 var(--font-display); color: var(--primary); margin-top: var(--space-md); }
</style>
