{
  "name": "calendar-ghost-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-markdown.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "audit:dist": "node scripts/audit-dist.mjs",
    "e2e": "playwright test",
    "test:worker": "playwright test --config playwright.worker.config.ts",
    "og-image": "node scripts/og-image.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/besley": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "astro": "7.3.6",
    "lucide-static": "1.52.0",
    "oxc-transform-react": "0.145.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "happy-dom": "20.14.5",
    "sharp": "0.35.5",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
