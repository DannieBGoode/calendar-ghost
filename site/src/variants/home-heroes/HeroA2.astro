---
// Hero A2, A made cleaner: the same copy column, and beside it a calmer week inside the page's
// width, so every control stays on screen. Three events (a work meeting and two personal plans
// that work sees as Busy), lighter lines, a plain Busy fill with the ghost glyph, no glow behind
// the ghost on light pages, and a hint that goes for good once the visitor has held the ghost.
import { WideReveal } from "../../islands/WideReveal"
import type { Messages } from "../../i18n"
import HeroPitch from "./HeroPitch.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
const [firstLine, secondLine] = m.variants.bold.hero.titleLines
---

<section class="hh hh-a2" aria-labelledby="hero-title">
  <div class="hh-a2-grid">
    <div class="hh-a2-copy">
      <h1 id="hero-title"><span>{firstLine}</span> <span class="hh-accent">{secondLine}</span></h1>
      <HeroPitch m={m} />
    </div>
    <div class="hh-a2-demo">
      <WideReveal
        client:load
        m={m.demo}
        motion={m.motion}
        weekHeight={400}
        phoneWeekHeight={300}
        handleSize={88}
        phoneHandleSize={72}
        ghostTone="mist"
        sweep={{ rest: 40, direction: "left", swing: 30 }}
        labels="divider"
        handleHint={m.variants.homeHeroes.handleHint}
        events={["standup", "dentist", "gym"]}
      />
    </div>
  </div>
</section>

<style>
  .hh-a2 { padding-block: clamp(1.5rem, 4vh, 3rem) 0; }
  .hh-a2-grid { width: min(72rem, 100% - 2 * var(--hh-gutter)); margin-inline: auto; display: grid; gap: 2rem; }
  .hh-a2-copy { min-width: 0; }
  .hh-a2-demo { min-width: 0; }
  .hh-a2-copy h1 { margin: 0 0 1.25rem; font-size: clamp(2.5rem, 1.6rem + 3.4vw, 3.5rem); }
  .hh-a2-demo :global(.reveal) { margin: 0; }

  /* Two and a half days at every width: Monday and Tuesday whole, and the edge of Wednesday to say
     the week carries on. */
  .hh-a2-demo :global(.reveal-week) { width: calc(100% * 5 / 2.5); }
  @media (min-width: 640px) {
    .hh-a2-demo :global(.cal-event) { padding: 5px 9px; font-size: 0.875rem; }
    .hh-a2-demo :global(.cal-event > small) { font-size: 0.8125rem; }
    .hh-a2-demo :global(.week-days) { font-size: 0.8125rem; }
  }

  /* Calmer: lighter lines between the days, and Busy as a plain fill with the ghost glyph (no
     hatch), its edge solid. */
  .hh-a2-demo :global(.week-days) { border-bottom-color: color-mix(in oklch, var(--border), transparent 40%); }
  .hh-a2-demo :global(.week-columns span + span) { border-left-color: color-mix(in oklch, var(--border), transparent 45%); }
  .hh-a2-demo :global(.cal-event.is-busy) {
    --event-edge: color-mix(in oklch, var(--primary), transparent 55%);
    background: var(--event-busy);
    border-style: solid;
  }

  /* The white ghost keeps its outline on light pages but loses the halo; at night it still glows. */
  .hh-a2-demo :global(.ghost[data-tone="mist"]) { --ghost-glow: light-dark(transparent, oklch(0.9 0.07 285 / 0.4)); }

  /* The hint is a quiet line under the ghost, and once the visitor has held it, it is gone. */
  .hh-a2-demo :global(.reveal-handle-hint) { font-weight: 550; color: var(--muted-foreground); box-shadow: none; }
  .hh-a2-demo :global(.reveal-frame[data-touched] .reveal-handle-hint) { opacity: 0; }

  /* The pause control: a quiet icon in the frame's top-right corner, always inside the page. */
  .hh-a2-demo :global(.reveal-frame > .motion-toggle) { background: transparent; box-shadow: none; color: var(--muted-foreground); }
  .hh-a2-demo :global(.reveal-frame > .motion-toggle:hover) { background: var(--muted); color: var(--foreground); }

  /* Side by side: the copy in A's column, the week in the rest of the page's width. */
  @media (min-width: 960px) {
    .hh-a2 { padding-top: clamp(2rem, 5vh, 3.5rem); }
    .hh-a2-grid {
      grid-template-columns: minmax(0, clamp(26rem, 13rem + 20vw, 30rem)) minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: center;
    }
  }
</style>
