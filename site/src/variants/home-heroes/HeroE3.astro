---
// Hero E3: the node diagram, semantically right, read left to right. On the left, "Your calendars":
// Sam's three calendars as hero E2's pills, Work among them. In the middle, the ghost (the
// character, Ghost.tsx). On the right, a day: "What work sees" (Sam's Work calendar) or, through
// the switch over it, "What you see" (Sam's Personal calendar). A chip carrying an event's title
// leaves each pill and goes through the ghost. Bound for Work, the Dentist and the family dinner
// lose their titles there, which stay by the ghost, struck through, and leave as indigo "Busy"
// chips; Work's own Standup passes with its title. Bound for Personal, every title stays. Each
// lands in the day at its time. The run plays once and rests with everything landed. Geometry and timing come from hub.ts; the motion is CSS (hub.css).
// Without JavaScript or with reduced motion the diagram stands still on its final state.
import "./hub.css"
import { avatarUrls } from "../../avatars"
import type { Messages } from "../../i18n"
import { format } from "../../i18n/format"
import { Ghost } from "../../islands/Ghost"
import HeroPitch from "./HeroPitch.astro"
import { HubControls } from "./HubControls"
import { buildHub, clock, faceStops, LAND_S, SOURCES, showsOnWork, type CalendarKey, type EventKey, type Hub, type Leg } from "./hub"

interface Props {
  m: Messages
}

const { m } = Astro.props
const [firstLine, secondLine] = m.variants.bold.hero.titleLines
const hb = m.variants.homeHeroes.hub
const avatars = await avatarUrls()
const hubs: Hub[] = [buildHub("wide"), buildHub("tall")]

const calendarName = (key: CalendarKey) => m.demo.calendars[key]
const eventTitle = (key: EventKey) => (key === "familyDinner" ? hb.events.familyDinner : m.demo.events[key].title)

const facts = [
  ...SOURCES.map((source) =>
    format(showsOnWork(source) === "busy" ? hb.busyFact : hb.ownFact, {
      event: eventTitle(source.event.key),
      from: calendarName(source.key),
      start: clock(source.event.start),
      end: clock(source.event.end),
    }),
  ),
  hb.never,
  hb.youFact,
]

/** Each layout's sizes, in diagram units (the pills' are hero E2's). */
const TYPE = {
  wide: { label: 13.5, name: 16.5, event: 13, avatar: 26, pad: 14, workAvatar: 28, workName: 16.5, account: 12.5, block: 12.5, hour: 10.5, chip: 11.5, trace: 11.5 },
  tall: { label: 12, name: 13.5, event: 11.5, avatar: 18, pad: 9, workAvatar: 22, workName: 14, account: 11.5, block: 11.5, hour: 9.5, chip: 10.5, trace: 10.5 },
} as const

/** A chip's size for its label: about half an em per letter, plus its padding. */
const chipSize = (label: string, size: number) => ({ width: Math.round(label.length * size * 0.56 + size * 1.5), height: Math.round(size * 1.8) })
const sourceTitle = (leg: Leg, hub: Hub) => eventTitle(hub.pills.find((pill) => pill.key === leg.source)!.event.key)
const pct = (value: number, of: number) => `${Math.round((value / of) * 10000) / 100}%`

/** Where each layout's controls sit: the switch over Work's day, level with the label it replaces;
 * Pause and Replay at the end of the calendars' label, over the first pill's right edge. */
const row = (hub: Hub) => {
  const pillsEnd = Math.max(...hub.pills.map((pill) => pill.x + pill.width))
  return [
    `--hb-${hub.kind}-views-left: ${pct(hub.work.x, hub.width)}`,
    `--hb-${hub.kind}-views-top: ${pct(hub.labels.work.y, hub.height)}`,
    `--hb-${hub.kind}-motion-right: ${pct(hub.width - pillsEnd, hub.width)}`,
    `--hb-${hub.kind}-motion-top: ${pct(hub.labels.calendars.y, hub.height)}`,
  ].join("; ")
}

/** The ghost's face over each layout's run, as keyframes for its pleased face (and the inverse for
 * its neutral one). They are named `hb-`, so the controls hold and replay them with the rest. */
const faceCss = hubs
  .map((hub) => {
    const stops = faceStops(hub)
    const pleased = stops.map(([at, opacity]) => `${at}%{opacity:${opacity}}`).join("")
    const neutral = stops.map(([at, opacity]) => `${at}%{opacity:${1 - opacity}}`).join("")
    return `@keyframes hb-face-${hub.kind}-then{${pleased}}@keyframes hb-face-${hub.kind}-first{${neutral}}`
  })
  .join("")
---

<section class="hh hh-e3" aria-labelledby="hero-title">
  <div class="hh-e3-wrap">
    <div class="hh-e3-copy">
      <h1 id="hero-title"><span>{firstLine}</span> <span class="hh-accent">{secondLine}</span></h1>
      <div class="hh-e3-pitch"><HeroPitch m={m} /></div>
    </div>

    <figure class="hb" data-playing="true" data-view="work" aria-labelledby="hb-summary" style={hubs.map(row).join("; ")}>
      <figcaption id="hb-summary" class="sr-only">{hb.summary}</figcaption>
      <ul class="sr-only">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>

      {
        hubs.map((hub) => {
          const type = TYPE[hub.kind]
          const wide = hub.kind === "wide"
          const id = (name: string) => `hb-${hub.kind}-${name}`
          const { work } = hub
          const workMiddle = work.y + work.header / 2
          const workTextX = work.x + type.pad + type.workAvatar + 10
          return (
            <div class={`hb-layout hb-${hub.kind}`} style={`--hb-run: ${hub.duration}s`}>
              <svg class="hb-svg" viewBox={`0 0 ${hub.width} ${hub.height}`} aria-hidden="true" focusable="false">
                <defs>
                  {hub.pills.map((pill) => (
                    <clipPath id={id(pill.key)}>
                      <circle cx={pill.x + type.pad + type.avatar / 2} cy={pill.y + pill.height / 2} r={type.avatar / 2} />
                    </clipPath>
                  ))}
                  <clipPath id={id("work-day")}>
                    <circle cx={work.x + type.pad + type.workAvatar / 2} cy={workMiddle} r={type.workAvatar / 2} />
                  </clipPath>
                </defs>

                <text class="hb-label" x={hub.labels.calendars.x} y={hub.labels.calendars.y} style={`font-size: ${type.label}px`}>
                  {hb.calendarsLabel}
                </text>
                <text class="hb-label hb-label-work" x={hub.labels.work.x} y={hub.labels.work.y} style={`font-size: ${type.label}px`}>
                  {m.demo.workSees}
                </text>

                <g class="hb-curves">
                  {hub.curves.map((curve) => (
                    <path d={curve.d} data-curve={curve.id} />
                  ))}
                </g>

                {hub.pills.map((pill) => {
                  const middle = pill.y + pill.height / 2
                  const textX = pill.x + type.pad + type.avatar + (wide ? 11 : 7)
                  const line = wide ? 9 : 7.5
                  const title = eventTitle(pill.event.key)
                  const event = wide ? format(hb.eventLine, { event: title, time: clock(pill.event.start) }) : title
                  return (
                    <g class="hb-pill" data-calendar={pill.key}>
                      <rect x={pill.x} y={pill.y} width={pill.width} height={pill.height} rx="6" />
                      <circle class="hb-ring" cx={pill.x + type.pad + type.avatar / 2} cy={middle} r={type.avatar / 2 + 2} />
                      <image href={avatars[pill.key]} x={pill.x + type.pad} y={middle - type.avatar / 2} width={type.avatar} height={type.avatar} clip-path={`url(#${id(pill.key)})`} />
                      <text x={textX} y={middle} style={`font-size: ${type.name}px`}>
                        <tspan x={textX} dy={-line}>
                          {calendarName(pill.key)}
                        </tspan>
                        <tspan class="hb-muted" x={textX} dy={line * 2} style={`font-size: ${type.event}px`}>
                          {event}
                        </tspan>
                      </text>
                    </g>
                  )
                })}

                <g class="hb-work">
                  <rect class="hb-box" x={work.x} y={work.y} width={work.width} height={work.height} rx="8" />
                  {(["work", "personal"] as const).map((calendar) => (
                    <g class={`hb-head ${calendar === "work" ? "hb-as-work" : "hb-as-you"}`} data-calendar={calendar}>
                      <image href={avatars[calendar]} x={work.x + type.pad} y={workMiddle - type.workAvatar / 2} width={type.workAvatar} height={type.workAvatar} clip-path={`url(#${id("work-day")})`} />
                      <text x={workTextX} y={workMiddle} style={`font-size: ${type.workName}px`}>
                        <tspan class="hb-name" x={workTextX} dy={-type.workName * 0.5}>
                          {m.demo.calendars[calendar]}
                        </tspan>
                        <tspan class="hb-muted" x={workTextX} dy={type.workName * 1.05} style={`font-size: ${type.account}px`}>
                          {m.app.rules.accounts[calendar]}
                        </tspan>
                      </text>
                    </g>
                  ))}
                  <path class="hb-rule" d={`M${work.x} ${work.y + work.header}h${work.width}`} />
                  {hub.hours.map(({ y, hour }) => (
                    <>
                      {hour > hub.hours[0]!.hour && <path class="hb-hour" d={`M${work.x + work.gutter - 6} ${y}H${work.x + work.width - 1}`} />}
                      <text class="hb-hour-label" x={work.x + work.gutter - 10} y={y + work.hour / 2} style={`font-size: ${type.hour}px`}>
                        {clock(hour)}
                      </text>
                    </>
                  ))}
                  {hub.blocks.map((block) => {
                    const middle = block.y + block.height / 2
                    const textX = block.x + (wide ? 19 : 15)
                    const time = `${clock(block.event.start)}–${clock(block.event.end)}`
                    const title = eventTitle(block.event.key)
                    return (
                      <g class="hb-block" data-source={block.source} data-event={block.event.key} data-shows={block.shows} style={`--delay: ${block.lands}s; --land: ${LAND_S}s`}>
                        <rect class="hb-paint" x={block.x} y={block.y} width={block.width} height={block.height} rx="4" />
                        {block.shows === "busy" && <rect class="hb-paint hb-paint-you" x={block.x} y={block.y} width={block.width} height={block.height} rx="4" />}
                        <circle class="hb-source-dot" cx={block.x + (wide ? 10 : 8)} cy={middle} r={wide ? 3.5 : 3} />
                        <text class={block.shows === "busy" ? "hb-as-work" : undefined} x={textX} y={middle} style={`font-size: ${type.block}px`}>
                          <tspan class="hb-block-title">{block.shows === "busy" ? m.demo.busy : title}</tspan>
                          <tspan class="hb-muted" dx="0.6em">
                            {time}
                          </tspan>
                        </text>
                        {block.shows === "busy" && (
                          <text class="hb-as-you" x={textX} y={middle} style={`font-size: ${type.block}px`}>
                            <tspan class="hb-block-title">{title}</tspan>
                            <tspan class="hb-muted" dx="0.6em">
                              {time}
                            </tspan>
                          </text>
                        )}
                      </g>
                    )
                  })}
                </g>

                <g class="hb-traces" style={`font-size: ${type.trace}px`}>
                  {hub.traces.map((trace) => (
                    <text class="hb-trace" data-source={trace.source} x={trace.x} y={trace.y} text-anchor={hub.traceAnchor} style={`--delay: ${trace.appears}s; --land: ${LAND_S}s`}>
                      {eventTitle(trace.event)}
                    </text>
                  ))}
                </g>

                <g class="hb-chips">
                  {hub.legs.map((leg) => {
                    const title = sourceTitle(leg, hub)
                    const busy = leg.shows === "busy"
                    const chip = chipSize(title.length > m.demo.busy.length || !busy ? title : m.demo.busy, type.chip)
                    return (
                      <g
                        class="hb-chip"
                        data-source={leg.source}
                        data-side={leg.side}
                        data-shows={leg.shows}
                        data-drops={leg.drops ? "" : undefined}
                        style={`offset-path: path('${leg.d}'); --delay: ${leg.delay}s; --travel: ${leg.duration}s`}
                      >
                        <rect x={-chip.width / 2} y={-chip.height / 2} width={chip.width} height={chip.height} rx={chip.height / 2} />
                        {busy ? (
                          <>
                            <text class="hb-as-work" x="0" y="0" style={`font-size: ${type.chip}px`}>
                              {m.demo.busy}
                            </text>
                            <text class="hb-as-you" x="0" y="0" style={`font-size: ${type.chip}px`}>
                              {title}
                            </text>
                          </>
                        ) : (
                          <text class="hb-chip-title" x="0" y="0" style={`font-size: ${type.chip}px`}>
                            {title}
                          </text>
                        )}
                      </g>
                    )
                  })}
                </g>
              </svg>
              <span class="hb-ghost" style={`left: ${pct(hub.ghost.x, hub.width)}; top: ${pct(hub.ghost.y, hub.height)}; width: ${pct(hub.ghost.width, hub.width)}`}>
                <Ghost face="neutral" then="happy" tone="mist" alive="still" />
              </span>
            </div>
          )
        })
      }

      <HubControls client:load m={{ views: { work: m.demo.workSees, you: m.demo.youSee }, viewLabel: hb.viewLabel, replay: hb.replay, motion: m.motion }} />
    </figure>
  </div>
</section>

<style is:inline set:html={faceCss}></style>

<style>
  .hh-e3 { padding-block: clamp(1.25rem, 3vh, 2.25rem) 0; overflow-x: clip; }
  .hh-e3-wrap { width: min(68rem, 100% - 2 * var(--hh-gutter)); margin-inline: auto; }
  .hh-e3-copy h1 { margin: 0 0 1rem; font-size: clamp(2.5rem, 1.6rem + 3.4vw, 3.5rem); }
  /* The pitch stays with the headline, in one block: the line, then the calls to action with the
     plain facts beside them. */
  .hh-e3-pitch { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 1.5rem; }
  .hh-e3-pitch :global(.hh-line) { grid-column: 1 / -1; max-width: 44rem; text-wrap: balance; }
  .hh-e3-pitch :global(.hh-ctas) { margin-top: 1.25rem; }
  .hh-e3-pitch :global(.hh-meta) { margin-top: 1.25rem; }
  @media (max-width: 639.98px) {
    .hh-e3-pitch { grid-template-columns: minmax(0, 1fr); }
  }
</style>
