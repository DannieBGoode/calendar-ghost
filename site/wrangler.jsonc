{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar-ghost-site",
  "compatibility_date": "2026-10-01",
  // The Worker adds discovery headers and Markdown negotiation to pages, and serves Umami's
  // tracker and events from this origin. Other assets bypass it.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/docs/*", "/lantern/*"]
  },
  "routes": [{ "pattern": "calendarghost.com", "custom_domain": true }]
}
