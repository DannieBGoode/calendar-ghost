---
// The self-host commands, each with a copy button, shared by every page that offers them. The
// commands come from content/self-host.ts, which a unit test keeps in step with the README.
import { SELF_HOST_COMMANDS } from "../content/self-host"
import type { Messages } from "../i18n"
import CopyCommand from "./CopyCommand.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<ol class="commands">
  {
    SELF_HOST_COMMANDS.map((command, index) => (
      <li>
        <p>{m.selfHost.steps[index]}</p>
        <CopyCommand m={m} id={`self-host-command-${index}`} command={command} />
      </li>
    ))
  }
</ol>

<style>
  /* Grid children default to their content's width; a long command must not widen the page. */
  .commands li { min-width: 0; }
  .commands { list-style: none; margin: 1rem 0; padding: 0; display: grid; gap: 1rem; }
  .commands p { margin: 0 0 0.35rem; font-weight: 600; font-size: 0.9375rem; }
</style>
