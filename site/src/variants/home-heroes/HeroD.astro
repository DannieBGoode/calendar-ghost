---
// Hero D, the same event with and without Calendar Ghost (after agentic.littleplains.com's "the
// same request, with and without the kit"). One input, Sam's Dentist on Personal, and two outputs
// side by side, both as the Work calendar shows it. Without Calendar Ghost the whole calendar is
// shared, so work sees every detail. With it, the rule's lines tick in one after another, each
// citing what it does, and the event on Work loses what that line keeps home until only Busy and
// the time are left. The sequence is CSS (same-event.css): it plays once from the first paint and
// rests. Without JavaScript or with reduced motion the page shows the rested state.
import "./same-event.css"
import Avatar from "../../components/Avatar.astro"
import Icon from "../../components/Icon.astro"
import type { IconName } from "../../icons"
import type { Messages } from "../../i18n"
import { Ghost } from "../../islands/Ghost"
import HeroPitch from "./HeroPitch.astro"
import { SameEventControls } from "./SameEventControls"

interface Props {
  m: Messages
}

const { m } = Astro.props
const [firstLine, secondLine] = m.variants.bold.hero.titleLines
const se = m.variants.homeHeroes.sameEvent
const dentist = m.demo.events.dentist

/**
 * Sam's Dentist, part by part. `by` is the rule line (its index in `se.rule`) that keeps the part
 * home, so it fades from the event on Work as that line ticks in; the time always crosses.
 */
const facts: { key: string; icon: IconName; text: string; by?: number }[] = [
  { key: "time", icon: "clock", text: `${m.demo.days[0]} 15:00–16:30` },
  { key: "place", icon: "mapPin", text: dentist.detail, by: 3 },
  { key: "guest", icon: "user", text: m.crossing.guests, by: 1 },
  { key: "link", icon: "video", text: m.crossing.link, by: 2 },
  { key: "note", icon: "alignLeft", text: m.variants.journey.crossing.description, by: 3 },
]
/** The line that turns the title into Busy. */
const SHOWS = 3
---

<section class="hh hh-d" aria-labelledby="hero-title">
  <div class="hh-d-grid">
    <div class="hh-d-copy">
      <h1 id="hero-title"><span>{firstLine}</span> <span class="hh-accent">{secondLine}</span></h1>
      <HeroPitch m={m} />
    </div>

    <figure class="se" data-playing="true" aria-labelledby="se-caption">
      <div class="se-head">
        <figcaption id="se-caption" class="se-caption">{se.caption}</figcaption>
        <SameEventControls client:load m={{ replay: se.replay, motion: m.motion }} />
      </div>

      <div class="se-input">
        <p class="se-cal"><Avatar calendar="personal" /> {m.demo.calendars.personal}</p>
        <div class="se-event se-source">
          <b class="se-title">{dentist.title}</b>
          <ul class="se-facts">
            {facts.map((fact) => <li data-fact={fact.key}><Icon name={fact.icon} class="se-icon" /><span class="se-fact">{fact.text}</span></li>)}
          </ul>
        </div>
      </div>

      <div class="se-split">
        <div class="se-side se-without" role="group" aria-labelledby="se-without">
          <p class="se-label" id="se-without">{se.without}</p>
          <ol class="se-rule se-shared">
            {
              se.shared.map((line) => (
                <li class="se-cite">
                  <span class="se-tick"><Icon name="eye" class="se-icon" /></span>
                  <span class="se-cite-text"><b>{line.key}:</b> {line.value}</span>
                </li>
              ))
            }
          </ol>
          <p class="se-cal"><Avatar calendar="work" /> {m.demo.workSees}</p>
          <div class="se-event se-exposed">
            <b class="se-title">{dentist.title}</b>
            <ul class="se-facts">
              {facts.map((fact) => <li data-fact={fact.key}><Icon name={fact.icon} class="se-icon" /><span class="se-fact">{fact.text}</span></li>)}
            </ul>
          </div>
        </div>

        <div class="se-side se-with" role="group" aria-labelledby="se-with">
          <p class="se-label" id="se-with">{se.with}</p>
          <div class="se-rule-wrap">
            <ol class="se-rule">
              {
                se.rule.map((line, index) => (
                  <li class="se-cite" style={`--i: ${index}`}>
                    <span class="se-tick"><Icon name="check" class="se-icon" /></span>
                    <span class="se-cite-text"><b>{line.key}:</b> {line.value}</span>
                  </li>
                ))
              }
            </ol>
            <span class="se-ghost">
              <Ghost face="neutral" then="happy" tone="mist" alive="loop" />
            </span>
          </div>
          <p class="se-cal"><Avatar calendar="work" /> {m.demo.workSees}</p>
          <div class="se-event se-busy-event">
            <span class="se-head-swap">
              <b class="se-title se-gone" style={`--by: ${SHOWS}`} aria-hidden="true">{dentist.title}</b>
              <b class="se-title se-busy" style={`--by: ${SHOWS}`}>{m.demo.busy}</b>
            </span>
            <ul class="se-facts">
              {
                facts.map((fact) =>
                  fact.by === undefined ? (
                    <li data-fact={fact.key}><Icon name={fact.icon} class="se-icon" /><span class="se-fact">{fact.text}</span></li>
                  ) : (
                    <li data-fact={fact.key} class="se-gone" style={`--by: ${fact.by}`} aria-hidden="true">
                      <Icon name={fact.icon} class="se-icon" /><span class="se-fact">{fact.text}</span>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hh-d { padding-block: clamp(1.5rem, 4vh, 3rem) 0; }
  .hh-d-grid { width: min(72rem, 100% - 2 * var(--hh-gutter)); margin-inline: auto; display: grid; gap: 2.5rem; }
  .hh-d-copy { min-width: 0; }
  .hh-d-copy h1 { margin: 0 0 1.25rem; font-size: clamp(2.5rem, 1.6rem + 3.4vw, 3.5rem); }

  /* Side by side from 960px: the copy in A's column, the figure beside it. */
  @media (min-width: 960px) {
    .hh-d { padding-top: clamp(2rem, 5vh, 3.5rem); }
    .hh-d-grid {
      grid-template-columns: minmax(0, clamp(26rem, 13rem + 20vw, 30rem)) minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: center;
    }
  }
</style>
