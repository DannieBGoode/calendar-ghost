---
import type { Messages } from "../../i18n"
import { Ghost, SpeechBubble } from "../../islands/Ghost"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<section class="b-section b-close b-faq" aria-labelledby="faq-title">
  <div class="b-wrap b-faq-grid">
    <div class="b-faq-side">
      <h2 id="faq-title">{m.faq.title}</h2>
      <div class="b-says" aria-hidden="true">
        <Ghost face="surprised" then="happy" tone="mist" alive="brief" float size={104} />
        <SpeechBubble side="right">{m.variants.bold.faq.ghost}</SpeechBubble>
      </div>
    </div>
    <div class="b-faq-list">
      {
        m.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .b-faq-grid > * { min-width: 0; }
  .b-faq-grid { display: grid; gap: var(--space-lg); }
  .b-faq-side h2 { margin-bottom: var(--space-md); }
  @media (min-width: 900px) {
    .b-faq-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; }
    .b-faq-side { position: sticky; top: 6rem; }
  }
  details { border-top: 1px solid var(--border); }
  details:last-child { border-bottom: 1px solid var(--border); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; padding-block: 0.75rem;
    cursor: pointer; list-style: none; font: 560 var(--step-1)/1.25 var(--font-display); letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  /* A plus that turns into a cross when the answer opens. */
  summary::after {
    content: "+"; flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%;
    background: var(--primary-soft); color: var(--primary); font: 500 1.4rem/1 var(--font-sans);
    transition: transform 240ms var(--ease-out);
  }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 0 0 1.25rem; color: var(--muted-foreground); font-size: var(--step-0); }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>
