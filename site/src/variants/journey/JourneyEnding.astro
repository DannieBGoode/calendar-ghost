---
// The last stop, in the ghost's own voice. The ghost that carried the Dentist down the margin
// arrives here (on wide screens it flies down from the margin and becomes this scene's ghost; on
// narrower ones it flies in from above), sets the card into the slot on Work's calendar, steps
// back and waves. The card is the hero's choice: Busy, or the title. The call to action is what
// the ghost says. Under it, the shared links, dressed as the back of the ticket: the route ends at
// a terminus, the groups are titled in the page's serif, and the no-trackers proof is a stamp
// like the stops' own.
import Avatar from "../../components/Avatar.astro"
import type { Messages } from "../../i18n"
import { Ghost } from "../../islands/Ghost"
import { REPO_URL } from "../../links"
import FooterLinks from "../../sections/FooterLinks.astro"
import Carried from "./Carried.astro"
import Stop from "./Stop.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<footer class="j-end night">
  <div class="j-wrap">
    <Stop m={m} n={9} name="end" />
    <div class="j-end-grid">
      <div class="j-end-scene" aria-hidden="true">
        <span class="j-end-shelf">
          <span class="j-end-shelf-head"><Avatar calendar="work" />{m.demo.calendars.work}</span>
          <span class="j-end-slot"></span>
        </span>
        <span class="j-end-puff"></span>
        <span class="j-end-drop"><Carried m={m} /></span>
        <span class="j-end-flyer">
          <span class="j-end-wave"><Ghost face="happy" then="wink" size={190} /></span>
        </span>
      </div>
      <div class="j-end-speech">
        <h2>{m.variants.journey.ending.says}</h2>
        <div class="ctas">
          <a class="btn btn-primary j-btn-big" href="#self-host">{m.hero.primary}</a>
          <a class="btn j-btn-big" href={REPO_URL} target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">★</span> {m.hero.secondary}<span class="sr-only"> {m.nav.newTab}</span>
          </a>
        </div>
      </div>
    </div>
    <div class="j-end-links">
      <FooterLinks m={m} />
    </div>
  </div>
</footer>

<script>
  // The arrival, once, when the scene is well in view. Where the margin's ghost is showing, it
  // flies down (transform only) to where this scene's ghost starts, then hands over: it hides, and
  // this scene's ghost, in the same place, carries on. Otherwise this scene's ghost flies in from
  // above. With reduced motion everything is simply in place. Without JavaScript the margin's
  // ghost never shows and this scene rests on its final frame.
  const journey = document.querySelector<HTMLElement>(".journey")
  const scene = document.querySelector<HTMLElement>(".j-end-scene")
  const carrier = document.querySelector<HTMLElement>(".j-rail-carrier")
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)")
  /** Where this scene's ghost starts after a hand-off, from where it rests, in rem (see below). */
  const START = { x: -6.5, y: 1.1 }

  function arrive(from: "rail" | "above") {
    if (journey) journey.dataset.delivered = ""
    if (scene) scene.dataset.awake = from
  }

  function deliver() {
    const railGhost = carrier?.querySelector<HTMLElement>(".ghost")
    const sceneGhost = scene?.querySelector<HTMLElement>(".j-end-flyer .ghost")
    const railShown = Boolean(carrier && railGhost && carrier.offsetParent !== null)
    if (!carrier || !railGhost || !sceneGhost || !railShown || reduced.matches) {
      arrive("above")
      return
    }
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize)
    const from = railGhost.getBoundingClientRect()
    const to = sceneGhost.getBoundingClientRect()
    const dx = to.left + START.x * rem + to.width / 2 - (from.left + from.width / 2)
    const dy = to.top + START.y * rem - from.top
    carrier.classList.add("is-flying")
    carrier.style.transform = `translate(${dx}px, ${dy}px) scale(${to.width / from.width})`
    let handed = false
    const handOver = () => {
      if (handed) return
      handed = true
      arrive("rail")
    }
    carrier.addEventListener("transitionend", handOver, { once: true })
    window.setTimeout(handOver, 1400)
  }

  if (scene) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return
        observer.disconnect()
        deliver()
      },
      { threshold: 0.6 },
    )
    observer.observe(scene)
  }
</script>

<style>
  /* The night sky at the end of the trip: the hero's dotted sky, after dark, whatever the device
     uses. The band re-declares the dark Twilight tokens so everything inside draws for the dark. */
  .j-end {
    position: relative; overflow: hidden; padding-block: var(--space-2xl) 2rem;
    background:
      radial-gradient(circle at 1px 1px, oklch(0.9 0.04 285 / 0.22) 1px, transparent 1.6px) 0 0 / 22px 22px,
      var(--night);
  }

  .j-end-grid { display: grid; gap: var(--space-lg); align-items: end; margin-bottom: var(--space-xl); }
  .j-end-grid > * { min-width: 0; }
  @media (min-width: 900px) { .j-end-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); } }

  /* The scene: Work's calendar with the slot, the plan set down in it, the ghost beside it. */
  .j-end-scene { position: relative; height: 18rem; max-width: 26rem; }
  .j-end-shelf {
    position: absolute; left: 0; right: 0; bottom: 0; height: 8.5rem; display: grid; align-content: start; gap: 0.7rem;
    padding: 0.85rem 1rem; border: 1px solid var(--border); border-radius: 1.1rem; background: var(--surface);
  }
  .j-end-shelf-head { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.875rem; }
  .j-end-shelf-head :global(.avatar) { width: 1.6rem; height: 1.6rem; }
  .j-end-slot { height: 3.6rem; border: 1.5px dashed var(--border); border-radius: 0.7rem; }
  .j-end-drop, .j-end-puff { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; height: 3.6rem; }
  .j-end-drop { transform-origin: 50% 100%; }
  .j-end-drop :global(.j-carry), .j-end-drop :global(.j-carry-card) { width: 100%; height: 100%; }
  .j-end-drop :global(.j-carry-card) { align-content: center; padding: 0.4rem 0.9rem; font-size: 0.9375rem; border-radius: 0.7rem; }
  .j-end-drop :global(.j-carry-card small) { font-size: 0.8125rem; }
  /* The landing beat: a ring that spreads from the slot as the card settles. */
  .j-end-puff { border: 2px solid var(--primary); border-radius: 0.9rem; opacity: 0; }
  .j-end-flyer { position: absolute; right: -0.5rem; bottom: 6.5rem; line-height: 0; }
  .j-end-wave { display: block; transform-origin: 50% 90%; }
  .j-end-flyer :global(.ghost) { --ghost-cutout: transparent; }

  /* The call to action is the ghost talking: a big speech bubble, its tail pointing at it. */
  .j-end-speech {
    position: relative; display: grid; justify-items: start; gap: 1.5rem; padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 2rem; background: oklch(0.96 0.015 285); color: oklch(0.22 0.06 280);
    --primary: oklch(0.47 0.15 278); --primary-foreground: oklch(0.99 0.004 285); --border: oklch(0.86 0.02 285);
    --surface: oklch(0.99 0.004 285); --foreground: oklch(0.22 0.06 280); --muted: oklch(0.93 0.02 285);
  }
  .j-end-speech::before {
    content: ""; position: absolute; left: 3rem; top: -0.9rem; width: 2rem; height: 2rem;
    background: inherit; transform: rotate(45deg); border-radius: 0.3rem;
  }
  @media (min-width: 900px) { .j-end-speech::before { left: -0.9rem; top: calc(50% - 1rem); } }
  .j-end-speech h2 { margin: 0; max-width: 18ch; font-size: var(--step-3); }

  /* The back of the ticket. The route ends here: a dotted line from a terminus mark. */
  .j-end-links { position: relative; padding-top: clamp(2.25rem, 4vw, 3rem); }
  .j-end-links::before {
    content: ""; position: absolute; top: 0; left: 1.5rem; right: 0; height: 2px;
    background: radial-gradient(circle, color-mix(in oklch, var(--primary), transparent 35%) 1px, transparent 1.5px) 0 0 / 10px 2px;
  }
  .j-end-links::after {
    content: ""; position: absolute; top: -7px; left: 0; width: 16px; height: 16px; border-radius: 50%;
    border: 2px solid var(--primary); background: var(--primary);
    box-shadow: 0 0 0 4px var(--night);
  }
  .j-end-links :global(.flinks-home) { font: 400 1.25rem/1 var(--font-display); }
  .j-end-links :global(.flinks-title) {
    font: 400 1.125rem/1.2 var(--font-display); letter-spacing: 0; text-transform: none; color: var(--primary);
  }
  /* The proof, stamped like a stop. */
  .j-end-links :global(.flinks-proof-title) {
    justify-self: start; padding: 0.45rem 0.7rem; border: 1.5px solid currentColor; border-radius: 0.4rem;
    color: var(--primary); font: 400 1rem/1.15 var(--font-display); transform: rotate(-2deg); transform-origin: 0 50%;
  }
  .j-end-links :global(.flinks-proof-icon) { color: currentColor; }
  .j-end-links :global(.flinks-proof) { gap: 0.75rem; }
  .j-end-links :global(.flinks-base) { border-top-style: dashed; }

  /* The ghost's face: happy while it carries, a wink once the card is down. */
  .j-end-scene :global(.ghost[data-sequence] .ghost-face-first) { animation: none; opacity: 0; }
  .j-end-scene :global(.ghost[data-sequence] .ghost-face-then) { animation: none; opacity: 1; }

  /* The arrival (the script above sets data-awake to where the ghost comes from). Under two
     seconds of flight and setting down, then a wave; all of it over within five seconds. Without
     JavaScript, or with reduced motion, the scene simply shows how it ends. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .j-end-scene:not([data-awake]) .j-end-drop, .j-end-scene:not([data-awake]) .j-end-flyer { opacity: 0; }

    .j-end-scene[data-awake="rail"] .j-end-flyer { animation: j-end-handed 1.6s cubic-bezier(0.45, 0, 0.25, 1) both; }
    .j-end-scene[data-awake="rail"] .j-end-drop { animation: j-end-set 1.6s cubic-bezier(0.45, 0, 0.25, 1) both; }
    .j-end-scene[data-awake="rail"] .j-end-puff { animation: j-end-puff 600ms var(--ease-out) 380ms both; }
    .j-end-scene[data-awake="rail"] .j-end-wave { animation: j-end-wave 1.4s ease-in-out 1.6s both; }
    .j-end-scene[data-awake="rail"] :global(.ghost-face-first) { animation: j-end-face-first 1s both !important; }
    .j-end-scene[data-awake="rail"] :global(.ghost-face-then) { animation: j-end-face-then 1s both !important; }

    .j-end-scene[data-awake="above"] .j-end-flyer { animation: j-end-from-above 2.4s cubic-bezier(0.45, 0, 0.25, 1) both; }
    .j-end-scene[data-awake="above"] .j-end-drop { animation: j-end-drop-above 2.4s cubic-bezier(0.45, 0, 0.25, 1) both; }
    .j-end-scene[data-awake="above"] .j-end-puff { animation: j-end-puff 600ms var(--ease-out) 1.2s both; }
    .j-end-scene[data-awake="above"] .j-end-wave { animation: j-end-wave 1.4s ease-in-out 2.4s both; }
    .j-end-scene[data-awake="above"] :global(.ghost-face-first) { animation: j-end-face-first 1.8s both !important; }
    .j-end-scene[data-awake="above"] :global(.ghost-face-then) { animation: j-end-face-then 1.8s both !important; }
  }
  /* Handed over from the margin: holding the card just over the slot, it sets it down, then steps
     back up beside it. */
  @keyframes j-end-handed {
    0% { transform: translate(-6.5rem, 1.1rem); }
    24%, 34% { transform: translate(-6.5rem, 2.3rem); }
    70%, 100% { transform: none; }
  }
  @keyframes j-end-set {
    0% { opacity: 0; transform: translateY(-1.2rem); }
    6% { opacity: 1; }
    24% { transform: none; }
    30% { transform: scale(1.03, 0.92); }
    38%, 100% { opacity: 1; transform: none; }
  }
  /* Flying in from above when there was no margin to ride down. */
  @keyframes j-end-from-above {
    0% { opacity: 0; transform: translate(-6.5rem, -12rem); }
    10% { opacity: 1; }
    50%, 58% { transform: translate(-6.5rem, 2.3rem); }
    82%, 100% { opacity: 1; transform: none; }
  }
  @keyframes j-end-drop-above {
    0% { opacity: 0; transform: translateY(-14.6rem); }
    10% { opacity: 1; }
    50% { transform: none; }
    54% { transform: scale(1.03, 0.92); }
    60%, 100% { opacity: 1; transform: none; }
  }
  @keyframes j-end-puff {
    0% { opacity: 0.7; transform: scale(0.97); }
    100% { opacity: 0; transform: scale(1.12, 1.35); }
  }
  @keyframes j-end-wave {
    0%, 100% { transform: none; }
    20% { transform: rotate(-11deg); }
    45% { transform: rotate(9deg); }
    70% { transform: rotate(-7deg); }
  }
  @keyframes j-end-face-first { 0%, 90% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes j-end-face-then { 0%, 90% { opacity: 0; } 100% { opacity: 1; } }
</style>
