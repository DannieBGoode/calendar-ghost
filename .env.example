# Copy to .env for local development. Never commit real Google or Microsoft credentials.
CALENDAR_SYNC_DATABASE_PATH=/data/calendar-sync.db
CALENDAR_SYNC_LOG_LEVEL=INFO
# Unset keeps logs in /data/logs; set it empty to turn file logging off, or to a path to move them.
# CALENDAR_SYNC_LOG_DIR=
CALENDAR_SYNC_SECURE_COOKIES=false
# Empty trusts no forwarded headers. Behind a proxy, list only its exact peer IPs or networks.
# Never use *. See docs/deployment.md for header rewriting and direct-access restrictions.
FORWARDED_ALLOW_IPS=
CALENDAR_SYNC_MASTER_KEY=
CALENDAR_SYNC_GOOGLE_CLIENT_ID=
CALENDAR_SYNC_GOOGLE_CLIENT_SECRET=
CALENDAR_SYNC_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
# Optional: Outlook through a Microsoft Entra application (docs/self-hosting.md).
CALENDAR_SYNC_MICROSOFT_CLIENT_ID=
CALENDAR_SYNC_MICROSOFT_CLIENT_SECRET=
CALENDAR_SYNC_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/oauth/microsoft/callback
CALENDAR_SYNC_MICROSOFT_TENANT=common
# Optional build-time URL for the Web UI's Source link. Prefer an immutable commit or release tag.
# CALENDAR_GHOST_SOURCE_URL=https://github.com/DannieBGoode/google-calendar-sync/tree/<commit-or-tag>
# The address people open Calendar Ghost at, also the trusted origin for password reset emails.
# Recovery requires an HTTPS root origin, except HTTP localhost or literal loopback development.
# CALENDAR_SYNC_PUBLIC_URL=https://calendar.example.com
# Optional incident delivery. Set either or both channels.
CALENDAR_SYNC_INCIDENT_WEBHOOK_URL=
CALENDAR_SYNC_SMTP_HOST=
CALENDAR_SYNC_SMTP_PORT=587
CALENDAR_SYNC_SMTP_USERNAME=
CALENDAR_SYNC_SMTP_PASSWORD=
CALENDAR_SYNC_SMTP_SENDER=
CALENDAR_SYNC_SMTP_RECIPIENT=
CALENDAR_SYNC_SMTP_STARTTLS=true
