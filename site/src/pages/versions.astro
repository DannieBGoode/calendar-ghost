---
// The team's index of every landing page version and iteration (src/versions.ts). Internal: not
// indexed, not in the sitemap, linked from no public page. Its words live in versions.ts, not in
// i18n/en.ts (see AGENTS.md, "Landing page").
import Layout from "../layouts/Layout.astro"
import { EARLIER_STATES, VERSIONS } from "../versions"

const title = "Versions · Calendar Ghost"
const description = "Every version and iteration of the Calendar Ghost landing page."
---

<Layout title={title} description={description} noindex>
  <main class="container versions">
    <h1>Versions</h1>
    <p class="lead">Every version of the landing page and every iteration of it. Old iterations are never overwritten: each new one is a new route.</p>

    {
      VERSIONS.map((version) => (
        <section class="versions-group" aria-labelledby={`v-${version.name}`}>
          <h2 id={`v-${version.name}`}>{version.name}</h2>
          <ol>
            {version.iterations.map((iteration) => (
              <li>
                <a class="versions-name" href={iteration.path}>{iteration.name}</a>
                <code>{iteration.path}</code>
                <p>{iteration.tries}</p>
                <p class="versions-meta">
                  {iteration.date} · <code>{iteration.commit}</code>
                </p>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <section class="versions-group" aria-labelledby="v-earlier">
      <h2 id="v-earlier">Earlier states</h2>
      <p>
        Before this index existed, pages were changed in place. To see one as it was, list the site's history
        with{" "}<code>git log -- site/</code>, then check out a past commit beside your work
        with{" "}<code>git worktree add ../calendar-ghost-&lt;sha&gt; &lt;sha&gt;</code>{" "}and
        run{" "}<code>npm install && npm run dev</code>{" "}in its{" "}<code>site/</code>{" "}folder.
      </p>
      <ul>
        {
          EARLIER_STATES.map((state) => (
            <li>
              <code>{state.commit}</code> {state.what}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

<style>
  .versions { padding-block: clamp(2.5rem, 6vw, 4.5rem); max-width: 52rem; }
  .versions-group { margin-top: 2.5rem; }
  .versions-group h2 { font-size: 1.75rem; }
  .versions ol, .versions ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .versions ol li {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1rem;
    padding: 1rem 1.1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
  }
  .versions ol li p { grid-column: 1 / -1; margin: 0.35rem 0 0; }
  .versions-name { font-weight: 700; font-size: 1.0625rem; display: inline-flex; align-items: center; min-height: 2.75rem; }
  .versions ol li > code { align-self: center; }
  .versions-meta { font-size: 0.875rem; color: var(--muted-foreground); }
  .versions code { font-size: 0.875em; overflow-wrap: anywhere; }
  .versions ul li { color: var(--muted-foreground); }
  .versions ul code { color: var(--foreground); }
</style>
