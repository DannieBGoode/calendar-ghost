---
// Stop 6: the app, feature by feature, framed as where you watch the ghost work.
import type { Messages } from "../../i18n"
import AppFeatures from "../../sections/AppFeatures.astro"
import Stop from "./Stop.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<AppFeatures m={m} class="j-section j-app" lead={m.variants.journey.app.body} split>
  <Stop m={m} n={6} name="app" slot="eyebrow" />
</AppFeatures>

<style>
  /* Young Serif has one weight; the feature titles take the page's scale. */
  :global(.journey .j-app) { --feat-title: var(--step-2); --feat-title-weight: 400; }
</style>
