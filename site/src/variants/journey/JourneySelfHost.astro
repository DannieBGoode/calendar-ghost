---
// Stop 7: your server. What it is in five facts, what you need, and the three commands.
import Icon from "../../components/Icon.astro"
import SelfHostCommands from "../../components/SelfHostCommands.astro"
import type { Messages } from "../../i18n"
import type { IconName } from "../../icons"
import { Ghost, SpeechBubble } from "../../islands/Ghost"
import { GUIDE_URL } from "../../links"
import Stop from "./Stop.astro"

interface Props {
  m: Messages
}

const { m } = Astro.props
const copy = m.variants.journey.selfHost
// One icon per fact, in the order of `facts`.
const FACT_ICONS: readonly IconName[] = ["box", "database", "cpu", "userX", "eyeOff"]
---

<section id="self-host" class="j-section j-self" aria-labelledby="self-host-title">
  <div class="j-wrap">
    <Stop m={m} n={7} name="server" />
    <div class="j-self-head">
      <div>
        <h2 id="self-host-title">{m.selfHost.title}</h2>
        <p class="j-lead">{m.selfHost.body}</p>
      </div>
      <div class="j-self-ghost" aria-hidden="true">
        <SpeechBubble side="right">{m.variants.bold.selfHost.ghost}</SpeechBubble>
        <span class="j-home">
          <Ghost face="happy" tone="moss" alive="brief" float size={120} />
          <span class="j-server"><i></i><i></i><b></b></span>
        </span>
      </div>
    </div>
    <ul class="j-facts" aria-label={copy.factsLabel}>
      {
        copy.facts.map((fact, index) => (
          <li>
            <Icon name={FACT_ICONS[index] ?? "check"} class="j-fact-icon" />
            {fact}
          </li>
        ))
      }
    </ul>
    <div class="j-self-grid">
      <div>
        <h3>{m.selfHost.needsTitle}</h3>
        <ul class="j-needs">
          {
            m.selfHost.needs.map((need) => (
              <li>
                <Icon name="check" class="j-needs-icon" />
                {need}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>{m.selfHost.stepsTitle}</h3>
        <SelfHostCommands m={m} />
        <p class="j-note-small">{m.selfHost.oauthNote}</p>
        <a class="btn btn-primary j-btn-big" href={GUIDE_URL}>{m.selfHost.guide}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .j-self-head { display: grid; gap: var(--space-md) var(--space-lg); align-items: end; }
  .j-self-head > * { min-width: 0; }
  .j-self-head .j-lead { margin: 0; }
  .j-self-ghost { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; justify-self: start; max-width: 100%; }
  .j-self-ghost :global(.speech-bubble) { position: relative; inset: auto; order: 2; max-width: min(15rem, 100%); }
  .j-self-ghost :global(.speech-bubble)::before { top: calc(50% - 0.325rem); }
  .j-home { display: grid; justify-items: center; }
  .j-home :global(.ghost) { position: relative; z-index: 1; margin-bottom: -1.1rem; }
  .j-server {
    position: relative; display: block; width: 10.5rem; height: 3rem; border-radius: 0.75rem;
    background: var(--foreground); box-shadow: 0 14px 30px -18px var(--foreground);
  }
  .j-server i { position: absolute; top: calc(50% - 0.25rem); width: 0.5rem; height: 0.5rem; border-radius: 50%; background: oklch(0.78 0.15 155); }
  .j-server i:first-child { left: 0.9rem; }
  .j-server i + i { left: 1.8rem; background: oklch(0.8 0.12 85); }
  .j-server b {
    position: absolute; right: 0.9rem; top: calc(50% - 0.55rem); width: 4.5rem; height: 1.1rem; border-radius: 0.3rem;
    background: repeating-linear-gradient(to right, color-mix(in oklch, var(--background), transparent 70%) 0 2px, transparent 2px 6px);
  }
  @media (min-width: 900px) {
    .j-self-head { grid-template-columns: minmax(0, 1fr) auto; }
    .j-self-ghost { justify-self: end; flex-direction: row-reverse; }
    .j-self-ghost :global(.speech-bubble) { order: 0; }
  }

  /* Five facts in one row: what it is, at a glance. */
  .j-facts {
    list-style: none; margin: var(--space-xl) 0 0; padding: 0; display: grid; gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    border-block: 1px solid var(--border);
  }
  .j-facts li {
    display: flex; align-items: center; gap: 0.7rem; padding: 1.15rem 1rem 1.15rem 0; max-width: none;
    font: 400 1.1875rem/1.2 var(--font-display);
  }
  .j-facts :global(.j-fact-icon) { flex: none; width: 1.5rem; height: 1.5rem; color: var(--primary); }

  .j-self-grid { display: grid; gap: var(--space-xl); margin-top: var(--space-xl); }
  .j-self-grid > div { min-width: 0; }
  @media (min-width: 960px) { .j-self-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: clamp(3rem, 6vw, 6rem); } }
  .j-needs { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.6rem; color: var(--muted-foreground); }
  .j-needs li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .j-needs :global(.j-needs-icon) { flex: none; width: 1.15rem; height: 1.15rem; margin-top: 0.25rem; color: var(--success-foreground); }
  .j-note-small { color: var(--muted-foreground); }
</style>
