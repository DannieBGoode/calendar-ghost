---
// Monitors, dashboards, and AI agents: one status answer (Installation Status), shown as what
// three tools make of it: a dashboard tile, an uptime monitor's checks, and an agent's answer.
// One sentence says it; the setup (tokens, the status API, the MCP server) lives on the
// self-hosting guide's page, section 6. Facts from docs/self-hosting.md and ADR 0024.
// A page can pass its own section class for spacing, and put something above the heading through
// the `eyebrow` slot; the section itself needs only the shared tokens.
import HomelabWatch from "../components/HomelabWatch.astro"
import Icon from "../components/Icon.astro"
import type { Messages } from "../i18n"
import claudeMark from "../marks/claude.svg?raw"
import { Ghost } from "../islands/Ghost"
import { INTEGRATIONS_URL } from "../links"

interface Props {
  m: Messages
  class?: string
}

const { m, class: sectionClass = "section" } = Astro.props
const copy = m.integrations
// The monitor's recent checks, oldest first: all up but one, when the installation needed a look.
const BEATS = 24
const ALERT_AT = 9
const beats = Array.from({ length: BEATS }, (_, index) => index === ALERT_AT)
/** The AI assistant answering in the agent mockup: a product name, so not translated. */
const AGENT = "Claude"
/** When the question was asked and answered, as the chat shows it: a clock time, not copy. */
const ASKED_AT = "09:41"
// Claude's mark, bundled from src/marks (nothing loads from another host), names a compatible
// client; it does not suggest that Anthropic endorses Calendar Ghost.
const AGENT_MARK = claudeMark.replace("<svg ", '<svg class="int-agent-mark" aria-hidden="true" focusable="false" ')
---

<section id="integrations" class:list={[sectionClass, "int"]} aria-labelledby="integrations-title">
  <div class="container">
    <div class="int-head">
      <slot name="eyebrow" />
      <h2 id="integrations-title">{copy.title}</h2>
      <p class="int-lead">{copy.body}</p>
    </div>

    <p class="sr-only">{copy.summary}</p>
    <!-- The night watch perches on the cards it reports to: on the uptime monitor's top edge on
         wide screens, on the first card's on phones. -->
    <div class="int-board">
    <HomelabWatch />
    <ul class="int-readers">
      <li class="int-reader">
        <h3>{copy.dashboard.label}</h3>
        <div class="int-mock int-dash" aria-hidden="true" data-wake>
          <span class="int-tile int-tile-ghost">
            <span class="int-tile-head">
              <Ghost face="happy" tone="moss" size={34} />
              <b>Calendar Ghost</b>
              <span class="int-dot"></span>
            </span>
            <span class="int-fields">
              <span class="int-field int-field-status"
                ><b>{copy.dashboard.healthy}</b><small>{copy.dashboard.statusLabel}</small></span
              >
              <span class="int-field"><b>{m.app.overview.running}</b><small>{copy.dashboard.summaryLabel}</small></span>
            </span>
          </span>
          <span class="int-tile int-tile-blank"><i></i><b></b><b></b></span>
          <span class="int-tile int-tile-blank"><i></i><b></b><b></b></span>
        </div>
      </li>
      <li class="int-reader">
        <h3>{copy.monitor.label}</h3>
        <div class="int-mock int-mon" aria-hidden="true" data-wake>
          <span class="int-mon-head">
            <span class="int-dot"></span>
            <b>Calendar Ghost</b>
            <span class="int-up">{copy.monitor.up}</span>
          </span>
          <span class="int-beats" style={`--beats: ${BEATS}`}>
            {beats.map((alert, index) => <i class:list={{ "is-alert": alert }} style={`--i: ${index}`} />)}
          </span>
          <span class="int-alert" style={`--at: ${ALERT_AT}; --beats: ${BEATS}`}>
            <Icon name="bell" class="int-alert-icon" />
            {copy.monitor.alerted}
          </span>
        </div>
      </li>
      <li class="int-reader">
        <h3>{copy.agent.label}</h3>
        <!-- A chat, in the shape everyone knows from messaging apps, in the site's own colours:
             the contact up top, the question on the right, the tool call as a small system
             note, and the answer on the left, in the assistant's own words. -->
        <div class="int-mock int-chat" aria-hidden="true" data-wake>
          <span class="int-chat-head">
            <span class="int-agent-avatar" set:html={AGENT_MARK} />
            <span class="int-chat-who"><b class="int-agent-name">{AGENT}</b><small>{copy.agent.via}</small></span>
          </span>
          <span class="int-chat-body">
            <span class="int-msg int-msg-you"
              ><span class="int-msg-text">{copy.agent.question}</span><span class="int-msg-meta"
                >{ASKED_AT}<svg class="int-read" viewBox="0 0 18 11" focusable="false"><path d="M1 6l3.2 3.2L11 2.2M7.5 8.6l.6.6L15 2.2" /></svg></span
              ></span
            >
            <span class="int-tool"><Icon name="check" class="int-tool-icon" />calendar-ghost · get_status</span>
            <span class="int-msg int-msg-agent"
              ><span class="int-msg-text">{copy.agent.answer}</span><span class="int-msg-meta">{ASKED_AT}</span></span
            >
          </span>
        </div>
      </li>
    </ul>
    </div>

    <a class="int-guide" href={INTEGRATIONS_URL}>{copy.guide}<Icon name="arrowRight" class="int-guide-icon" /></a>
  </div>
</section>

<style>
  .int {
    --int-ok: oklch(0.70 0.15 155);
    --int-mock-bg: var(--surface);
  }
  :root[data-theme="dark"] .int { --int-ok: oklch(0.74 0.14 155); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .int { --int-ok: oklch(0.74 0.14 155); }
  }

  /* The heading and one sentence, the whole idea in a few seconds: a plain column. */
  .int-head h2 { max-width: 16ch; }
  .int-lead { max-width: 44ch; margin: 0; color: var(--muted-foreground); font-size: 1.125rem; }

  /* The cards, and the night watch standing on them. The watch's foot line sits on the top edge
     of the uptime monitor's card (the middle one, its right end), whose newest check beats in time
     with each tick on the watch's clipboard; on phones, where the cards stack, on the first card's.
     The space above the cards is the watch's perch. */
  .int-board {
    --int-label-h: 1.25rem;
    --int-label-gap: 0.6rem;
    --int-gap: 1.75rem;
    position: relative; margin-top: 6.5rem;
  }
  .int-board > :global(.watch) {
    position: absolute; z-index: 1; right: 0.85rem;
    top: calc(var(--int-label-h) + var(--int-label-gap) + 1px);
    transform: translateY(-100%);
  }
  .int-readers { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--int-gap); }
  .int-reader { display: grid; align-content: start; gap: var(--int-label-gap); min-width: 0; }
  .int-reader h3 { margin: 0; font-size: 0.8125rem; line-height: var(--int-label-h); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-foreground); }
  .int-mock {
    position: relative; min-height: 13.5rem; padding: 1rem; overflow: hidden;
    border: 1px solid var(--border); border-radius: calc(var(--panel-radius) + 0.25rem); background: var(--int-mock-bg);
    font-size: 0.8125rem;
  }
  .int-dot { width: 0.55rem; height: 0.55rem; flex: none; border-radius: 50%; background: var(--int-ok); }

  /* A dashboard: Calendar Ghost's tile among the homelab's other services. */
  .int-dash { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 0.6rem; align-content: center; }
  .int-tile { display: grid; gap: 0.4rem; padding: 0.7rem; border-radius: 0.65rem; border: 1px solid var(--border); background: var(--background); }
  .int-tile-blank { align-content: start; opacity: 0.7; }
  .int-tile-blank i { width: 1.4rem; height: 1.4rem; border-radius: 0.4rem; background: var(--muted); }
  .int-tile-blank b { height: 0.45rem; border-radius: 999px; background: var(--muted); }
  .int-tile-blank b + b { width: 60%; }
  .int-tile-ghost {
    grid-column: 1 / -1; gap: 0.6rem;
    border-color: color-mix(in oklch, var(--int-ok), transparent 45%);
    box-shadow: 0 10px 24px -18px color-mix(in oklch, var(--int-ok), transparent 20%);
  }
  .int-tile-head { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; }
  .int-tile-head b { flex: 1; min-width: 0; }
  .int-fields { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem; }
  .int-field { display: grid; padding: 0.35rem 0.6rem; border-radius: 0.45rem; background: var(--muted); line-height: 1.3; }
  .int-field b { font-weight: 650; }
  .int-field small { font-size: 0.6875rem; color: var(--muted-foreground); }
  .int-field-status { background: var(--success-soft); color: var(--success-foreground); }
  .int-field-status small { color: inherit; }

  /* An uptime monitor: the latest checks, the one that alerted, and the rule it checks. */
  .int-mon { display: grid; align-content: center; gap: 0.75rem; }
  .int-mon-head { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; }
  .int-mon-head b { flex: 1; }
  .int-up {
    padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;
    background: var(--success-soft); color: var(--success-foreground);
  }
  .int-beats { display: grid; grid-template-columns: repeat(var(--beats), minmax(0, 1fr)); gap: 3px; height: 2.1rem; }
  .int-beats i { border-radius: 999px; background: var(--int-ok); transform-origin: 50% 100%; }
  .int-beats i.is-alert { background: var(--warning-bar); }
  /* The alert's tag hangs under its check: --at of --beats along the line. */
  .int-alert {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.35rem; position: relative;
    margin-left: clamp(0rem, calc((var(--at) + 0.5) / var(--beats) * 100% - 1.1rem), 100%);
    padding: 0.25rem 0.6rem 0.25rem 0.45rem; border-radius: 0.5rem;
    background: var(--warning-soft); color: var(--warning-foreground); font-size: 0.75rem; font-weight: 650;
  }
  .int-alert::before {
    content: ""; position: absolute; top: -0.3rem; left: 0.85rem; width: 0.6rem; height: 0.6rem;
    background: inherit; transform: rotate(45deg);
  }
  .int-mock :global(.int-alert-icon) { width: 0.95rem; height: 0.95rem; flex: none; }

  /* An AI agent, as a chat: a slim header with the contact, a faintly patterned wall, bubbles
     with tails (the question on the right, the answer on the left), each with its time in the
     corner, and the tool call as a centred system note between them. */
  .int-chat {
    --chat-wall: color-mix(in oklch, var(--muted) 70%, var(--surface));
    --chat-dot: color-mix(in oklch, var(--muted-foreground), transparent 86%);
    --chat-you: var(--primary-soft);
    --chat-them: var(--background);
    display: grid; grid-template-rows: auto 1fr; padding: 0; background: var(--chat-wall);
  }
  .int-chat-head {
    display: flex; align-items: center; gap: 0.55rem; padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--border); background: var(--surface);
  }
  .int-agent-avatar {
    display: grid; place-items: center; flex: none; width: 1.9rem; height: 1.9rem; border-radius: 50%;
    border: 1px solid var(--border); background: var(--background);
  }
  .int-mock :global(.int-agent-mark) { width: 1.1rem; height: 1.1rem; }
  .int-chat-who { display: grid; line-height: 1.2; }
  .int-agent-name { font-size: 0.875rem; font-weight: 700; color: var(--foreground); }
  .int-chat-who small { font-size: 0.6875rem; color: var(--muted-foreground); }
  .int-chat-body {
    display: grid; align-content: center; gap: 0.5rem; padding: 0.85rem 0.85rem 1rem;
    background-image: radial-gradient(var(--chat-dot) 1px, transparent 1.4px); background-size: 14px 14px;
  }
  .int-msg {
    position: relative; display: block; max-width: 86%; padding: 0.45rem 0.65rem 0.4rem;
    border-radius: 0.6rem; font-size: 0.8125rem; line-height: 1.4; color: var(--foreground);
    box-shadow: 0 1px 1px color-mix(in oklch, var(--foreground), transparent 90%);
  }
  /* The tail: a small corner folded out of the bubble's top, toward its sender's side. */
  .int-msg::before {
    content: ""; position: absolute; top: 0; width: 0.55rem; height: 0.6rem; background: inherit;
  }
  .int-msg-you { justify-self: end; border-top-right-radius: 0; background: var(--chat-you); }
  .int-msg-you::before { right: -0.5rem; clip-path: polygon(0 0, 100% 0, 0 100%); }
  .int-msg-agent { justify-self: start; border-top-left-radius: 0; background: var(--chat-them); }
  .int-msg-agent::before { left: -0.5rem; clip-path: polygon(0 0, 100% 0, 100% 100%); }
  /* The time sits in the bubble's bottom-right corner, after the last line. */
  .int-msg-meta {
    float: right; display: inline-flex; align-items: center; gap: 0.2rem; margin: 0.35rem -0.1rem -0.1rem 0.6rem;
    font-size: 0.625rem; line-height: 1; color: var(--muted-foreground); font-variant-numeric: tabular-nums;
  }
  .int-read { width: 0.95rem; height: 0.6rem; fill: none; stroke: var(--primary); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .int-tool {
    justify-self: center; display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.6rem; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.6875rem; color: var(--muted-foreground);
  }
  .int-mock :global(.int-tool-icon) { width: 0.85rem; height: 0.85rem; color: var(--success-foreground); }

  /* The way to the setup: one quiet link, not another call to action. */
  .int-guide {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; margin-top: 1.5rem;
    font-weight: 650; text-decoration: none; text-underline-offset: 0.25em;
  }
  .int-guide:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .int-guide :global(.int-guide-icon) { width: 1.1rem; height: 1.1rem; transition: transform 200ms var(--ease-out); }
  .int-guide:hover :global(.int-guide-icon) { transform: translateX(3px); }

  @media (min-width: 900px) {
    .int-board { --int-gap: clamp(1.25rem, 2.5vw, 2rem); margin-top: 5.25rem; }
    .int-readers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    /* The middle card's right end: one card and one gap in from the board's right edge. */
    .int-board > :global(.watch) { right: calc((100% - 2 * var(--int-gap)) / 3 + var(--int-gap) + 0.85rem); }
  }
  /* Where the middle card is narrow, the watch stands a little smaller, clear of the card's label. */
  @media (min-width: 900px) and (max-width: 1199px) {
    .int-board > :global(.watch) { transform: translateY(-100%) scale(0.8); transform-origin: 100% 100%; }
  }

  /* Once, when each tool first comes into view: the checks come in one by one, the answer
     arrives after the question. Without JavaScript, or with reduced motion, everything is
     simply there. Nothing here runs longer than five seconds, so it needs no pause control. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .int-mon:not([data-awake]) .int-beats i,
    .int-mon:not([data-awake]) .int-alert,
    .int-chat:not([data-awake]) .int-chat-body > *,
    .int-dash:not([data-awake]) .int-field-status { opacity: 0; }
    .int-mon[data-awake] .int-beats i { animation: int-beat 360ms var(--ease-out) both; animation-delay: calc(var(--i) * 55ms); }
    .int-mon[data-awake] .int-alert { animation: int-rise 420ms var(--ease-out) both; animation-delay: calc(var(--at) * 55ms + 200ms); }
    .int-chat[data-awake] .int-chat-body > * { animation: int-rise 420ms var(--ease-out) both; }
    .int-chat[data-awake] .int-tool { animation-delay: 700ms; }
    .int-chat[data-awake] .int-msg-agent { animation-delay: 1400ms; }
    .int-dash[data-awake] .int-field-status { animation: int-pop 420ms var(--ease-out) 500ms both; }
  }
  /* The monitor's newest check beats in time with the night watch's ticks (HomelabWatch.astro:
     a 6s round, boxes ticked from 8% to 18%, 23% to 33%, and 38% to 48% of it). Both loops start
     with the page's first style, so they keep step; the newest bar draws itself on a layer of its
     own, so the bars' arrival above still applies to it. Stopped, it simply stands, like the rest. */
  .int-beats i:last-child { position: relative; background: transparent; }
  .int-beats i:last-child::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; background: var(--int-ok); transform-origin: 50% 100%;
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion="paused"])) .int-beats i:last-child::before { animation: int-newest 6s var(--ease-out) infinite; }
  }
  @keyframes int-newest {
    0%, 6%, 18%, 21%, 33%, 36%, 48%, 100% { opacity: 1; transform: none; }
    8%, 23%, 38% { opacity: 0.2; transform: scaleY(0.2); }
  }
  @keyframes int-beat { from { opacity: 0; transform: scaleY(0.2); } to { opacity: 1; transform: none; } }
  @keyframes int-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes int-pop { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: none; } }
</style>
