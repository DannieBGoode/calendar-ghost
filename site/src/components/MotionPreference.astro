---
// The site-wide animations control, in the footer's link area (sections/FooterLinks.astro): a
// quiet text button that says what it will do, "Pause animations" or "Play animations"
// (lib/motion-preference.ts). Pressed, it stops every loop on the page and remembers that; the
// demos' own pause controls stay for the demos. While the device asks for reduced motion the
// animations are off and stay off, and the button says so instead. Without JavaScript nothing
// loops, so it stays hidden.
//
// Its words change with the state, so it carries no `aria-pressed`: a toggle's name must not change
// when it is pressed (WAI-ARIA Authoring Practices), and here the words are the clearer signal.
import Icon from "./Icon.astro"
import type { Messages } from "../i18n"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<button type="button" class="motion-preference" data-motion-toggle data-state="running" hidden>
  <span class="motion-preference-icon" aria-hidden="true"><Icon name="pause" /></span>
  <span class="motion-preference-icon" aria-hidden="true"><Icon name="play" /></span>
  <span class="motion-preference-label" data-label-for="running">{m.motion.pauseAll}</span>
  <span class="motion-preference-label" data-label-for="stopped">{m.motion.playAll}</span>
  <span class="motion-preference-label" data-label-for="device">{m.motion.pausedByDevice}</span>
</button>

<script>
  import {
    applyMotionPaused,
    deviceReducesMotion,
    MOTION_STORAGE_KEY,
    readMotionPaused,
    REDUCED_MOTION_QUERY,
    writeMotionPaused,
  } from "../lib/motion-preference"

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-motion-toggle]")) {
    const render = () => {
      const device = deviceReducesMotion()
      button.dataset.state = device ? "device" : readMotionPaused() ? "stopped" : "running"
      if (device) button.setAttribute("aria-disabled", "true")
      else button.removeAttribute("aria-disabled")
    }
    button.hidden = false
    render()

    button.addEventListener("click", () => {
      if (deviceReducesMotion()) return
      const paused = !readMotionPaused()
      writeMotionPaused(paused)
      applyMotionPaused(paused)
      render()
    })

    // Another tab changing the choice, or the device's setting changing, updates this one too.
    window.addEventListener("storage", (event) => {
      if (event.key !== MOTION_STORAGE_KEY && event.key !== null) return
      applyMotionPaused(readMotionPaused())
      render()
    })
    if (typeof matchMedia === "function") matchMedia(REDUCED_MOTION_QUERY).addEventListener("change", render)
  }
</script>

<style>
  /* Quiet, like the footer's other small print: no box, the muted colour, a finger-sized target. */
  .motion-preference {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.75rem; padding: 0;
    border: 0; background: transparent; color: var(--muted-foreground);
    font: 600 0.875rem/1.3 var(--font-sans); text-align: left; text-underline-offset: 0.25em; cursor: pointer;
  }
  .motion-preference:hover:not([aria-disabled]) { color: var(--foreground); text-decoration: underline; text-decoration-thickness: 1px; }
  .motion-preference[aria-disabled] { cursor: default; font-weight: 500; }
  .motion-preference-icon { display: none; flex: none; width: 0.95rem; height: 0.95rem; }
  .motion-preference-icon :global(svg) { width: 100%; height: 100%; }
  .motion-preference-label { display: none; }
  /* One icon and one set of words at a time: what pressing it will do. */
  .motion-preference[data-state="running"] .motion-preference-icon:nth-child(1),
  .motion-preference[data-state="stopped"] .motion-preference-icon:nth-child(2),
  .motion-preference[data-state="running"] [data-label-for="running"],
  .motion-preference[data-state="stopped"] [data-label-for="stopped"],
  .motion-preference[data-state="device"] [data-label-for="device"] {
    display: inline;
  }
  .motion-preference[data-state="running"] .motion-preference-icon:nth-child(1),
  .motion-preference[data-state="stopped"] .motion-preference-icon:nth-child(2) { display: inline-flex; }
</style>
