---
// The page's one Twilight moment: the Haunted Week at night, where the ghost is the lantern.
import { Ghost, SpeechBubble } from "../../islands/Ghost"
import { HauntedWeek } from "../../islands/HauntedWeek"
import type { Messages } from "../../i18n"

interface Props {
  m: Messages
}

const { m } = Astro.props
---

<section class="b-night" aria-labelledby="week-title">
  <div class="b-wrap b-night-inner">
    <div class="b-night-head">
      <div>
        <h2 id="week-title">{m.week.title}</h2>
        <p class="b-lead">{m.week.body}</p>
      </div>
      <div class="b-says b-night-says" aria-hidden="true">
        <span class="b-lantern"><Ghost face="wink" tone="mist" alive="brief" float size={150} /></span>
        <SpeechBubble side="left" className="b-night-bubble">{m.variants.bold.week.ghost}</SpeechBubble>
      </div>
    </div>
    <HauntedWeek client:visible m={m.demo} motion={m.motion} summary={m.week.summary} ghostTone="mist" />
  </div>
</section>

<style>
  .b-night-head > * { min-width: 0; }
  /* The band carries the app's dark Twilight tokens, so everything inside (the week, its events,
     the pause control) draws as it does in dark appearance, whatever the device uses. */
  .b-night {
    color-scheme: dark;
    --background: var(--night);
    --foreground: oklch(0.95 0.012 285);
    --surface: var(--night-deep);
    --muted: oklch(0.3 0.05 280);
    --muted-foreground: oklch(0.8 0.03 285);
    --primary: oklch(0.78 0.11 278);
    --primary-foreground: oklch(0.17 0.03 280);
    --border: oklch(0.38 0.05 280);
    --ring: oklch(0.78 0.11 278);
    --event-work: oklch(0.27 0.045 280);
    --event-personal: oklch(0.45 0.09 155 / 0.9);
    --event-personal-edge: oklch(0.72 0.12 155);
    --event-family: oklch(0.5 0.09 80 / 0.85);
    --event-family-edge: oklch(0.8 0.12 80);
    --event-busy: oklch(0.42 0.09 278 / 0.6);
    position: relative; overflow: hidden;
    padding-block: var(--space-2xl) var(--space-xl);
    background:
      radial-gradient(1.5px 1.5px at 12% 18%, oklch(0.95 0.02 285 / 0.7), transparent),
      radial-gradient(1px 1px at 27% 8%, oklch(0.95 0.02 285 / 0.6), transparent),
      radial-gradient(1.5px 1.5px at 46% 22%, oklch(0.95 0.02 285 / 0.5), transparent),
      radial-gradient(1px 1px at 63% 12%, oklch(0.95 0.02 285 / 0.7), transparent),
      radial-gradient(1.5px 1.5px at 88% 6%, oklch(0.95 0.02 285 / 0.6), transparent),
      radial-gradient(1px 1px at 94% 30%, oklch(0.95 0.02 285 / 0.5), transparent),
      var(--night);
    color: var(--foreground);
  }
  .b-night-head {
    display: grid; gap: var(--space-md); align-items: end; margin-bottom: var(--space-lg);
  }
  .b-night-head h2 { max-width: 13ch; }
  .b-night-says { justify-self: end; flex-direction: row-reverse; }
  .b-night-says :global(.b-night-bubble) { font-size: 1rem; }
  .b-night-says :global(.b-night-bubble)::before { top: calc(50% - 0.325rem); }

  /* The lantern: a soft pool of light around the ghost, the only glow on the page. */
  .b-lantern { position: relative; display: inline-block; line-height: 0; }
  .b-lantern::before {
    content: ""; position: absolute; inset: -55%; z-index: 0; border-radius: 50%;
    background: radial-gradient(circle, oklch(0.9 0.06 285 / 0.38), oklch(0.8 0.08 280 / 0.12) 40%, transparent 68%);
  }
  .b-lantern :global(.ghost) { position: relative; z-index: 1; }

  /* The roaming ghost in the week carries its own light across the events. */
  .b-night :global(.haunt-ghost)::before {
    content: ""; position: absolute; inset: -110%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, oklch(0.92 0.05 285 / 0.3), oklch(0.85 0.06 280 / 0.1) 38%, transparent 66%);
  }
  .b-night :global(.haunt-ghost .ghost) { position: relative; --ghost-cutout: transparent; }
  .b-night :global(.haunt-frame) { box-shadow: 0 30px 80px -40px oklch(0.05 0.04 280); }
  .b-night :global(.ghost[data-tone="mist"]) {
    --ghost-body: oklch(0.96 0.02 285); --ghost-edge: oklch(0.96 0.02 285); --ghost-tab: oklch(0.86 0.04 285);
    --ghost-ink: oklch(0.22 0.06 280); --ghost-aside: oklch(0.96 0.02 285); --ghost-shadow: oklch(0.05 0.03 280 / 0.6);
  }
  .b-night :global(.speech-bubble) { --bubble-bg: oklch(0.96 0.015 285); --bubble-edge: transparent; color: oklch(0.22 0.06 280); }

  @media (min-width: 900px) {
    .b-night-head { grid-template-columns: minmax(0, 1fr) auto; }
    .b-night-says { margin-right: 1rem; margin-bottom: -0.5rem; }
  }
</style>
